    "faq": {
      "type": "section",
      "blocks": {
        "faq_heading": {
          "type": "text",
          "settings": {
            "text": "<h2>Your questions, answered</h2>",
            "type_preset": "rte",
            "width": "fit-content",
            "max_width": "narrow"
          }
        },
        "faq_accordion": {
          "type": "accordion",
          "settings": {
            "icon": "caret",
            "dividers": true,
            "type_preset": "h5",
            "inherit_color_scheme": true
          },
          "blocks": {
            "row_1": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How Is LIVEENHANCED Personalized For Me?"
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>We use a detailed questionnaire and optional lab results to create a formula uniquely tailored to your biology, lifestyle, and goals.</p>",
                    "type_preset": "rte",
                    "width": "100%",
                    "max_width": "normal"
                  }
                }
              },
              "block_order": ["text"]
            },
            "row_2": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How Long Does It Take To Notice Results With LIVEENHANCED?"
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Most users report noticeable improvements in energy, focus, and recovery within the first 2-4 weeks of consistent use.</p>",
                    "type_preset": "rte",
                    "width": "100%",
                    "max_width": "normal"
                  }
                }
              },
              "block_order": ["text"]
            },
            "row_3": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Is LIVEENHANCED safe to take every day?"
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. All ingredients are third-party tested, clinically dosed, and designed for daily use. Consult your healthcare provider if you have specific concerns.</p>",
                    "type_preset": "rte",
                    "width": "100%",
                    "max_width": "normal"
                  }
                }
              },
              "block_order": ["text"]
            },
            "row_4": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Can I Take LIVEENHANCED With Other Supplements?"
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>LIVEENHANCED is designed as a comprehensive formula. While it can be taken alongside other supplements, we recommend consulting with your healthcare provider to avoid redundancy.</p>",
                    "type_preset": "rte",
                    "width": "100%",
                    "max_width": "normal"
                  }
                }
              },
              "block_order": ["text"]
            },
            "row_5": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Can LIVEENHANCED Change As My Goals Evolve?"
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Absolutely. Your formula can be adjusted as your goals, lifestyle, or health needs change over time. Simply retake the assessment to get an updated recommendation.</p>",
                    "type_preset": "rte",
                    "width": "100%",
                    "max_width": "normal"
                  }
                }
              },
              "block_order": ["text"]
            }
          },
          "block_order": ["row_1", "row_2", "row_3", "row_4", "row_5"]
        },
        "faq_button": {
          "type": "button",
          "settings": {
            "label": "ADD TO CART",
            "style_class": "button",
