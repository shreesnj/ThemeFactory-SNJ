{% doc %}
  Mobile Bottom Navigation Bar

  Renders a fixed-position bottom navigation bar for mobile devices (below 749px).
  Contains menu trigger, search trigger, and cart icon.

  @example
  {% render 'mobile-bottom-nav' %}
{% enddoc %}

<div class="mobile-bottom-nav" role="navigation" aria-label="{{ 'accessibility.header_navigation_label' | t }}">
  <div class="mobile-bottom-nav__inner">
    <button
      type="button"
      class="mobile-bottom-nav__action mobile-bottom-nav__menu-trigger"
      aria-label="{{ 'accessibility.menu' | t }}"
      aria-haspopup="dialog"
    >
      <span class="svg-wrapper">
        {{- 'icon-menu.svg' | inline_asset_content -}}
      </span>
    </button>

    <button
      type="button"
      class="mobile-bottom-nav__action mobile-bottom-nav__search-trigger"
      aria-label="{{ 'content.search_input_label' | t }}"
      aria-haspopup="dialog"
    >
      <span class="svg-wrapper">
        {{- 'icon-search.svg' | inline_asset_content -}}
      </span>
    </button>

    <a
      href="{{ routes.cart_url }}"
      class="mobile-bottom-nav__action mobile-bottom-nav__cart-trigger"
      aria-label="{{ 'content.cart_title' | t }}"
    >
      <span class="svg-wrapper">
        {{- 'icon-cart.svg' | inline_asset_content -}}
      </span>
      {% render 'cart-bubble', limit: 100 %}
    </a>
  </div>
</div>

<style>
  .mobile-bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 60px;
    background-color: var(--color-background, #ffffff);
    border-top: 1px solid var(--color-border, #e6e6e6);
    z-index: var(--layer-header, 100);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    display: none;
  }

  @media screen and (max-width: 749px) {
    .mobile-bottom-nav {
      display: block;
    }

    body {
      padding-bottom: calc(60px + env(safe-area-inset-bottom, 0px));
    }
  }

  @media screen and (min-width: 750px) {
    .mobile-bottom-nav {
      display: none;
    }
  }

  .mobile-bottom-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-around;
    height: 60px;
    max-width: 100%;
    padding-inline: var(--padding-sm, 16px);
  }

  .mobile-bottom-nav__action {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-width: 44px;
    min-height: 44px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-foreground, #000000);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-bottom-nav__action .svg-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-bottom-nav__action svg {
    width: var(--icon-size-md, 20px);
    height: var(--icon-size-md, 20px);
  }

  .mobile-bottom-nav__action:focus-visible {
    outline: 2px solid var(--color-foreground, #000000);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .mobile-bottom-nav__cart-trigger {
    position: relative;
  }

  .mobile-bottom-nav__cart-trigger .cart-bubble {
    position: absolute;
    top: 4px;
    right: 0;
  }
</style>

<script type="module">
  const mobileNav = document.querySelector('.mobile-bottom-nav');

  if (mobileNav) {
    const menuTrigger = mobileNav.querySelector('.mobile-bottom-nav__menu-trigger');
    const searchTrigger = mobileNav.querySelector('.mobile-bottom-nav__search-trigger');

    if (menuTrigger) {
      menuTrigger.addEventListener('click', () => {
        const drawerDetails = document.querySelector('#Details-menu-drawer-container');
        if (drawerDetails) {
          const summary = drawerDetails.querySelector('summary');
          if (summary) {
            summary.click();
          }
        }
      });
    }

    if (searchTrigger) {
      searchTrigger.addEventListener('click', () => {
        const searchModal = document.querySelector('#search-modal');
        if (searchModal && typeof searchModal.showDialog === 'function') {
          searchModal.showDialog();
        } else if (searchModal && typeof searchModal.show === 'function') {
          searchModal.show();
        } else {
          const searchButton = document.querySelector('search-button button');
          if (searchButton) {
            searchButton.click();
          }
        }
      });
    }
  }
</script>
