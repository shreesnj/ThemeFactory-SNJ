{%- doc -%}
  Custom Footer Social Icons

  Renders social media icon links for the custom footer section.

  @param {object} section - The section object containing social URL settings
{%- enddoc -%}

{%- if section.settings.social_email_url != blank -%}
  <a href='{{ section.settings.social_email_url }}' class='custom-footer__social-link' aria-label='Email'>
    <img
      src="{{ 'social-email-a421a6e2faaa.svg' | asset_url }}"
      alt=""
      width="20"
      height="20"
      loading="lazy"
    >
  </a>
{%- endif -%}

{%- if section.settings.social_instagram_url != blank -%}
