<div class="results-banner color-{{ section.settings.color_scheme }}" style="--rb-padding-top: {{ section.settings.padding_top }}px; --rb-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="results-banner__wrapper">
    <div class="results-banner__image-container">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: section.settings.image.width
          | image_tag:
            sizes: '(min-width: 990px) 1420px, calc(100vw - 20px)',
            widths: '375,750,1100,1420,1780,2000',
            loading: 'lazy',
            alt: section.settings.image.alt | default: section.settings.heading,
            class: 'results-banner__image'
        }}
      {%- endif -%}
      <div class="results-banner__overlay"></div>
      <div class="results-banner__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="results-banner__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="results-banner__button">
            <span>{{ section.settings.button_label }}</span>
            <img src="{{ 'solar-arrow-up-linear.svg' | asset_url }}" alt="" width="32" height="32" class="results-banner__button-icon">
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.results-banner {
  padding-inline: 10px;
}

.results-banner__wrapper {
  max-width: 1440px;
  margin: 0 auto;
}

.results-banner__image-container {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  min-height: 447px;
}

.results-banner__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  inset: 0;
}

.results-banner__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.1) 60%, transparent 100%);
  z-index: 1;
}

.results-banner__content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 32px;
  padding: 40px;
  min-height: 447px;
  justify-content: flex-end;
}

.results-banner__heading {
  font-size: 80px;
  font-weight: 700;
  line-height: 80px;
  letter-spacing: -2.4px;
  text-transform: uppercase;
  color: #ffffff;
  margin: 0;
  max-width: 619px;
}

.results-banner__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 2px;
  padding: 8px 40px;
  background-color: #0033FF;
  color: #ffffff;
  border-radius: 24px;
  font-size: 16px;
  font-weight: 700;
  line-height: 20px;
  text-transform: uppercase;
  text-decoration: none;
  min-height: 48px;
  width: fit-content;
  transition: background-color 0.2s ease;
}

.results-banner__button:hover {
  background-color: #0029CC;
}

.results-banner__button-icon {
  width: 32px;
  height: 32px;
  transform: rotate(45deg);
  filter: brightness(0) invert(1);
}

@media screen and (max-width: 749px) {
  .results-banner {
    padding-inline: 8px;
  }

  .results-banner__image-container {
    min-height: 400px;
  }

  .results-banner__content {
    min-height: 400px;
    padding: 20px;
  }

  .results-banner__heading {
    font-size: 40px;
    line-height: 40px;
    letter-spacing: -1.2px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.results_banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for Measurable Results"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "CREATE YOUR FORMULA"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:names.results_banner"
    }
  ]
}
{% endschema %}
