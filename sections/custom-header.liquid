{{ 'custom-sections.css' | asset_url | stylesheet_tag }}

<div class="custom-header">
  <a href="/" class="custom-header__logo" aria-label="{{ shop.name }}">
    <img src="{{ 'shop-logo.svg' | asset_url }}" alt="{{ shop.name }}" width="178" height="24" loading="eager">
  </a>

  <button
    type="button"
    class="custom-header__search"
    aria-label="{{ section.settings.search_placeholder }}"
    data-custom-header-search
  >
    <span class="custom-header__search-text">{{ section.settings.search_placeholder }}</span>
    <span class="custom-header__search-icon">
      <img src="{{ 'search-streamline-sharp-streamline-material-free.svg' | asset_url }}" alt="" width="20" height="20">
    </span>
  </button>

  <div class="custom-header__right">
    {% if section.settings.cta_text != blank %}
      <a href="{{ section.settings.cta_link }}" class="custom-header__cta">
        {{ section.settings.cta_text }}
      </a>
    {% endif %}

    <div class="custom-header__actions">
      <span class="custom-header__flag">
        <img src="{{ 'us-united-states-streamline-flagpack.svg' | asset_url }}" alt="US" width="18" height="18">
      </span>

      <a href="{{ routes.account_login_url }}" class="custom-header__action">
        <span class="custom-header__action-icon">
          <img src="{{ 'frame-663.svg' | asset_url }}" alt="" width="20" height="20">
        </span>
        <span>Sign in</span>
      </a>

      <a href="{{ routes.cart_url }}" class="custom-header__action">
        <span class="custom-header__action-icon">
          <img src="{{ 'shopping-bag-streamline-outlined-material-symbols.svg' | asset_url }}" alt="" width="28" height="28">
        </span>
        <span>Cart</span>
      </a>
    </div>
  </div>

  <button
    type="button"
    class="custom-header__mobile-btn"
    aria-label="Menu"
    data-custom-header-mobile-btn
  >
    <img src="{{ 'shopping-bag-streamline-outlined-material-symbols.svg' | asset_url }}" alt="" width="18" height="18">
  </button>
</div>

<script>
  (function() {
    const searchBtn = document.querySelector('[data-custom-header-search]');
    if (searchBtn) {
      searchBtn.addEventListener('click', function() {
        const searchModal = document.getElementById('search-modal');
        if (searchModal) {
          const dialog = searchModal.querySelector('dialog');
          if (dialog && typeof dialog.showModal === 'function') {
            dialog.showModal();
          }
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "t:names.custom_header",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "cta_text",
      "label": "t:content.cta_text",
      "default": "Take Quiz"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:content.cta_link"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "t:content.search_placeholder",
      "default": "Search products"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
