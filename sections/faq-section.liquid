<div class="faq-section color-{{ section.settings.color_scheme }}" style="--faq-padding-top: {{ section.settings.padding_top }}px; --faq-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="faq-section__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq-section__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="faq-section__accordion">
      {%- for block in section.blocks -%}
        <details class="faq-section__item" {{ block.shopify_attributes }}>
          <summary class="faq-section__question">
            <span class="faq-section__question-text">{{ block.settings.question | escape }}</span>
            <span class="faq-section__icon" aria-hidden="true">
              <svg width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9.5 2.5V16.5M2.5 9.5H16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </summary>
          {%- if block.settings.answer != blank -%}
            <div class="faq-section__answer">
              {{ block.settings.answer }}
            </div>
          {%- endif -%}
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="faq-section__button-wrapper">
        <a href="{{ section.settings.button_link }}" class="faq-section__button">
          <span>{{ section.settings.button_label | escape }}</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.faq-section {
  padding-block-start: var(--faq-padding-top, 80px);
  padding-block-end: var(--faq-padding-bottom, 80px);
  padding-inline: 24px;
}

.faq-section__inner {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 40px;
  max-width: 804px;
  margin: 0 auto;
}

.faq-section__heading {
  font-family: var(--font-heading--family);
  font-size: 40px;
  font-weight: 500;
  line-height: 44px;
  color: rgb(var(--color-foreground-heading));
  margin: 0;
}

.faq-section__accordion {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.faq-section__item {
  width: 100%;
  border-bottom: 2px solid rgb(var(--color-border));
}

.faq-section__question {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  cursor: pointer;
  list-style: none;
  padding-block: 30px;
  width: 100%;
}

.faq-section__item:first-child > .faq-section__question {
  padding-block-start: 0;
}

.faq-section__question::-webkit-details-marker {
  display: none;
}

.faq-section__question-text {
  font-family: var(--font-body--family);
  font-size: 24px;
  font-weight: 400;
  line-height: 26px;
  color: rgb(var(--color-foreground-heading));
}

.faq-section__icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgb(var(--color-foreground-heading));
  transition: transform 0.2s ease;
}

.faq-section__icon svg {
  width: 19px;
  height: 19px;
}

.faq-section__item[open] .faq-section__icon {
  transform: rotate(45deg);
}

.faq-section__answer {
  padding-block-end: 30px;
  padding-inline-end: 43px;
  font-family: var(--font-body--family);
  font-size: 16px;
  font-weight: 400;
  line-height: 1.6;
  color: rgb(var(--color-foreground));
}

.faq-section__answer p {
  margin: 0;
}

.faq-section__button-wrapper {
  display: flex;
  justify-content: center;
  width: 100%;
}

.faq-section__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 8px 40px;
  background-color: rgb(var(--color-button));
  color: rgb(var(--color-button-text));
  border-radius: 100px;
  border: none;
  font-family: var(--font-body--family);
  font-size: 16px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  text-decoration: none;
  min-height: 48px;
  transition: background-color 0.2s ease;
}

.faq-section__button:hover {
  background-color: rgb(var(--color-button-hover));
}

@media screen and (max-width: 749px) {
  .faq-section {
    padding-inline: 16px;
  }

  .faq-section__inner {
    gap: 32px;
  }

  .faq-section__heading {
    font-size: 32px;
    line-height: 35px;
  }

  .faq-section__question {
    padding-block: 12px;
  }

  .faq-section__item:first-child > .faq-section__question {
    padding-block-start: 0;
  }

  .faq-section__question-text {
    font-size: 16px;
    line-height: 22px;
  }

  .faq-section__icon svg {
    width: 14px;
    height: 14px;
  }

  .faq-section__answer {
    padding-inline-end: 0;
    padding-block-end: 12px;
  }

  .faq-section__button {
    width: 100%;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.faq_section_custom",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your questions, answered"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "ADD TO CART"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "faq-item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.faq_section_custom",
      "blocks": [
        {
          "type": "faq-item",
          "settings": {
            "question": "Is LIVEENHANCED Safe To Take Every Day?",
            "answer": "<p>Yes, LIVEENHANCED is formulated with clinically tested ingredients that are safe for daily use. Each ingredient is carefully selected and dosed to ensure optimal safety and efficacy.</p>"
          }
        },
        {
          "type": "faq-item",
          "settings": {
            "question": "How Long Does It Take To Notice Results With LIVEENHANCED?",
            "answer": "<p>Most users begin to notice improvements within 2-4 weeks of consistent daily use. However, individual results may vary based on your unique biology and goals.</p>"
          }
        },
        {
          "type": "faq-item",
          "settings": {
            "question": "How Is LIVEENHANCED Personalized For Me?",
            "answer": "<p>We use a comprehensive assessment of your goals, lifestyle, and biology to create a custom formula tailored specifically to your needs.</p>"
          }
        },
        {
          "type": "faq-item",
          "settings": {
            "question": "Can LIVEENHANCED Change As My Goals Evolve?",
            "answer": "<p>Absolutely. Your formula can be adjusted as your goals and needs change over time, ensuring you always have the optimal blend for your current objectives.</p>"
          }
        },
        {
          "type": "faq-item",
          "settings": {
            "question": "Can I Take LIVEENHANCED With Other Supplements?",
            "answer": "<p>In most cases, yes. However, we recommend consulting with your healthcare provider before combining LIVEENHANCED with other supplements to ensure there are no interactions.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
