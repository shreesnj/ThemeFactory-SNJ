<div class="faq-section color-{{ section.settings.color_scheme }}" style="--faq-padding-top: {{ section.settings.padding_top }}px; --faq-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="faq-section__inner">
    {%- if section.settings.heading != blank -%}
      <div class="faq-section__heading-group">
        {%- if section.settings.label != blank -%}
          <p class="faq-section__label">{{ section.settings.label | escape }}</p>
        {%- endif -%}
        <h2 class="faq-section__heading">
          {%- if section.settings.heading_accent != blank -%}
            {%- assign parts = section.settings.heading | split: section.settings.heading_accent -%}
            {{ parts[0] }}<span class="faq-section__heading-accent">{{ section.settings.heading_accent }}</span>{% if parts.size > 1 %}{{ parts[1] }}{% endif %}
          {%- else -%}
            {{ section.settings.heading }}
          {%- endif -%}
        </h2>
      </div>
    {%- endif -%}

    <div class="faq-section__accordion">
      {%- for block in section.blocks -%}
        <details class="faq-section__item" {{ block.shopify_attributes }}>
          <summary class="faq-section__question">
            <span class="faq-section__question-text">{{ block.settings.question }}</span>
            <span class="faq-section__icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 3V13M3 8H13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </summary>
          {%- if block.settings.answer != blank -%}
            <div class="faq-section__answer">
              {{ block.settings.answer }}
            </div>
          {%- endif -%}
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="faq-section__button-wrapper">
        <a href="{{ section.settings.button_link }}" class="faq-section__button">
          <span>{{ section.settings.button_label }}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.faq-section {
  padding-block-start: var(--faq-padding-top, 64px);
  padding-block-end: var(--faq-padding-bottom, 64px);
  padding-inline: 24px;
}

.faq-section__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 48px;
  max-width: 840px;
  margin: 0 auto;
}

.faq-section__heading-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  text-align: center;
}

.faq-section__label {
  font-family: var(--font-body--family);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #F9A31A;
  margin: 0;
}

.faq-section__heading {
  font-family: var(--font-heading--family);
  font-size: 40px;
  font-weight: 500;
  line-height: 1.1;
  letter-spacing: -1px;
  text-align: center;
  color: rgb(var(--color-foreground-heading));
  margin: 0;
}

.faq-section__heading-accent {
  color: #F9A31A;
}

.faq-section__accordion {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.faq-section__item {
  width: 100%;
  border-block-end: 1px solid rgb(var(--color-border));
}

.faq-section__item:first-child {
  border-block-start: 1px solid rgb(var(--color-border));
}

.faq-section__question {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  cursor: pointer;
  list-style: none;
  padding-block: 20px;
  width: 100%;
}

.faq-section__question::-webkit-details-marker {
  display: none;
}

.faq-section__question-text {
  font-family: var(--font-body--family);
  font-size: 18px;
  font-weight: 500;
  line-height: 1.4;
  color: rgb(var(--color-foreground-heading));
}

.faq-section__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background-color: rgb(var(--color-foreground-heading));
  color: rgb(var(--color-background));
  transition: transform 0.25s ease, background-color 0.2s ease;
}

.faq-section__icon svg {
  width: 16px;
  height: 16px;
}

.faq-section__item[open] .faq-section__icon {
  transform: rotate(45deg);
  background-color: #F9A31A;
}

.faq-section__answer {
  padding-block-end: 20px;
  font-family: var(--font-body--family);
  font-size: 16px;
  font-weight: 400;
  line-height: 1.65;
  color: rgb(var(--color-foreground));
  padding-inline-end: 56px;
}

.faq-section__answer p {
  margin: 0;
}

.faq-section__button-wrapper {
  display: flex;
  justify-content: center;
}

.faq-section__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 48px;
  background-color: rgb(var(--color-button));
  color: rgb(var(--color-button-text));
  border-radius: 100px;
  border: 1px solid rgb(var(--color-button));
  font-family: var(--font-body--family);
  font-size: 14px;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  text-decoration: none;
  min-height: 48px;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

.faq-section__button:hover {
  background-color: rgb(var(--color-button-hover));
  border-color: rgb(var(--color-button-hover));
}

@media screen and (max-width: 749px) {
  .faq-section {
    padding-inline: 20px;
  }

  .faq-section__heading {
    font-size: 28px;
    letter-spacing: -0.5px;
  }

  .faq-section__question-text {
    font-size: 16px;
  }

  .faq-section__answer {
    padding-inline-end: 0;
    font-size: 15px;
  }

  .faq-section__icon {
    width: 28px;
    height: 28px;
  }

  .faq-section__icon svg {
    width: 14px;
    height: 14px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.faq_section_custom",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Questions, Answered"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "default": "Answered"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "ADD TO CART"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 64,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "faq-item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.faq_section_custom",
      "blocks": [
        {
          "type": "faq-item",
          "settings": {
            "question": "Is LIVEENHANCED Safe To Take Every Day?",
            "answer": "<p>Yes, LIVEENHANCED is formulated with clinically tested ingredients that are safe for daily use. Each ingredient is carefully selected and dosed to ensure optimal safety and efficacy.</p>"
          }
        },
        {
          "type": "faq-item",
          "settings": {
            "question": "How Long Does It Take To Notice Results With LIVEENHANCED?",
            "answer": "<p>Most users begin to notice improvements within 2-4 weeks of consistent daily use. However, individual results may vary based on your unique biology and goals.</p>"
          }
        },
        {
          "type": "faq-item",
          "settings": {
            "question": "How Is LIVEENHANCED Personalized For Me?",
            "answer": "<p>We use a comprehensive assessment of your goals, lifestyle, and biology to create a custom formula tailored specifically to your needs.</p>"
          }
        },
        {
          "type": "faq-item",
          "settings": {
            "question": "Can LIVEENHANCED Change As My Goals Evolve?",
            "answer": "<p>Absolutely. Your formula can be adjusted as your goals and needs change over time, ensuring you always have the optimal blend for your current objectives.</p>"
          }
        },
        {
          "type": "faq-item",
          "settings": {
            "question": "Can I Take LIVEENHANCED With Other Supplements?",
            "answer": "<p>In most cases, yes. However, we recommend consulting with your healthcare provider before combining LIVEENHANCED with other supplements to ensure there are no interactions.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
