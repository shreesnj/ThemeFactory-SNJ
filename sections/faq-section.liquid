<div class="faq-section color-{{ section.settings.color_scheme }}" style="--faq-padding-top: {{ section.settings.padding_top }}px; --faq-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="faq-section__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq-section__heading">
        {%- if section.settings.heading_accent != blank -%}
          {%- assign parts = section.settings.heading | split: section.settings.heading_accent -%}
          {{ parts[0] }}<span class="faq-section__heading-accent">{{ section.settings.heading_accent }}</span>{% if parts.size > 1 %}{{ parts[1] }}{% endif %}
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h2>
    {%- endif -%}

    <div class="faq-section__accordion">
      {%- for block in section.blocks -%}
        <details class="faq-section__item" {{ block.shopify_attributes }}>
          <summary class="faq-section__question">
            <span class="faq-section__question-text {% if forloop.first %}faq-section__question-text--first{% endif %}">{{ block.settings.question }}</span>
            <span class="faq-section__icon">
              <svg width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M9.5 4V15M4 9.5H15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </summary>
          {%- if block.settings.answer != blank -%}
            <div class="faq-section__answer">
              {{ block.settings.answer }}
            </div>
          {%- endif -%}
        </details>
        {%- unless forloop.last -%}
          <div class="faq-section__divider"></div>
        {%- endunless -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="faq-section__button-wrapper">
        <a href="{{ section.settings.button_link }}" class="faq-section__button">
          <span>{{ section.settings.button_label }}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.faq-section {
  padding-block-start: var(--faq-padding-top, 64px);
  padding-block-end: var(--faq-padding-bottom, 64px);
  padding-inline: 24px;
}

.faq-section__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40px;
  max-width: 804px;
  margin: 0 auto;
}

.faq-section__heading {
  font-size: 40px;
  font-weight: 500;
  line-height: 44px;
  letter-spacing: -1.2px;
  text-transform: capitalize;
  text-align: center;
  color: rgb(var(--color-foreground-heading));
  margin: 0;
}

.faq-section__heading-accent {
  color: #0033FF;
}

.faq-section__accordion {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.faq-section__item {
  width: 100%;
}

.faq-section__question {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  list-style: none;
  padding-block: 15px;
  width: 100%;
}

.faq-section__question::-webkit-details-marker {
  display: none;
}

.faq-section__question-text {
  font-size: 24px;
  font-weight: 400;
  line-height: 26px;
  text-transform: capitalize;
  color: rgb(var(--color-foreground-heading));
}

.faq-section__question-text--first {
  font-weight: 700;
}

.faq-section__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 19px;
  height: 19px;
  color: #000000;
  transition: transform 0.2s ease;
}

.faq-section__item[open] .faq-section__icon {
  transform: rotate(45deg);
}

.faq-section__answer {
  padding-block-end: 16px;
  font-size: 16px;
  font-weight: 400;
  line-height: 22px;
  color: #4D4D4D;
}

.faq-section__divider {
  height: 2px;
  background-color: #EAECF0;
  width: 100%;
}

.faq-section__button-wrapper {
  display: flex;
  justify-content: center;
}

.faq-section__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 40px;
  background-color: #0033FF;
  color: #ffffff;
  border-radius: 24px;
  font-size: 16px;
  font-weight: 700;
  line-height: 20px;
  text-transform: uppercase;
  text-decoration: none;
  min-height: 48px;
  transition: background-color 0.2s ease;
}

.faq-section__button:hover {
  background-color: #0029CC;
}

@media screen and (max-width: 749px) {
  .faq-section {
    padding-inline: 16px;
  }

  .faq-section__heading {
    font-size: 32px;
    line-height: 35px;
    letter-spacing: -0.96px;
  }

  .faq-section__question-text {
    font-size: 18px;
    line-height: 22px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.faq_section_custom",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Questions, Answered"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "default": "Answered"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "ADD TO CART"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 64,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "faq-item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.faq_section_custom",
      "blocks": [
        {
          "type": "faq-item",
          "settings": {
            "question": "Is LIVEENHANCED Safe To Take Every Day?",
            "answer": "<p>Yes, LIVEENHANCED is formulated with clinically tested ingredients that are safe for daily use. Each ingredient is carefully selected and dosed to ensure optimal safety and efficacy.</p>"
          }
        },
        {
          "type": "faq-item",
          "settings": {
            "question": "How Long Does It Take To Notice Results With LIVEENHANCED?",
            "answer": "<p>Most users begin to notice improvements within 2-4 weeks of consistent daily use. However, individual results may vary based on your unique biology and goals.</p>"
          }
        },
        {
          "type": "faq-item",
          "settings": {
            "question": "How Is LIVEENHANCED Personalized For Me?",
            "answer": "<p>We use a comprehensive assessment of your goals, lifestyle, and biology to create a custom formula tailored specifically to your needs.</p>"
          }
        },
        {
          "type": "faq-item",
          "settings": {
            "question": "Can LIVEENHANCED Change As My Goals Evolve?",
            "answer": "<p>Absolutely. Your formula can be adjusted as your goals and needs change over time, ensuring you always have the optimal blend for your current objectives.</p>"
          }
        },
        {
          "type": "faq-item",
          "settings": {
            "question": "Can I Take LIVEENHANCED With Other Supplements?",
            "answer": "<p>In most cases, yes. However, we recommend consulting with your healthcare provider before combining LIVEENHANCED with other supplements to ensure there are no interactions.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
