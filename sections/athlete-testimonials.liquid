  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading_subtitle",
      "label": "Subtitle",
      "default": "Our Athletes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Validated by Leading Athletes"
