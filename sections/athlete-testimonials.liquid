{% liquid
  assign heading_subtitle = section.settings.heading_subtitle
  assign heading = section.settings.heading
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} athlete-testimonials color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="athlete-testimonials__header">
    <div class="athlete-testimonials__header-text">
      {%- if heading_subtitle != blank -%}
        <p class="athlete-testimonials__subtitle">{{ heading_subtitle | escape }}</p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="athlete-testimonials__heading">{{ heading | escape }}</h2>
      {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <a
        {%- if section.settings.button_link != blank %}
          href="{{ section.settings.button_link }}"
        {%- endif %}
        class="athlete-testimonials__header-button"
      >
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>

  <div class="athlete-testimonials__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'athlete-card' -%}
        <div class="athlete-testimonials__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="athlete-testimonials__card-bg">
              {%- liquid
                assign sizes_val = '(min-width: 990px) 25vw, 80vw'
              -%}
              {{
                block.settings.image
                | image_url: width: block.settings.image.width
                | image_tag:
                  sizes: sizes_val,
                  widths: '375,550,750',
                  loading: 'lazy',
                  class: 'athlete-testimonials__card-image',
                  alt: block.settings.image.alt
              }}
            </div>
          {%- endif -%}

          <div class="athlete-testimonials__card-overlay">
            {%- if block.settings.quote != blank -%}
              <p class="athlete-testimonials__quote">{{ block.settings.quote | escape }}</p>
            {%- endif -%}
            <div class="athlete-testimonials__card-info">
              {%- if block.settings.name != blank -%}
                <p class="athlete-testimonials__name">{{ block.settings.name | escape }}</p>
              {%- endif -%}
              {%- if block.settings.role != blank -%}
                <p class="athlete-testimonials__role">{{ block.settings.role | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .athlete-testimonials {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .athlete-testimonials__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }

  .athlete-testimonials__header-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .athlete-testimonials__subtitle {
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: 500;
    font-size: var(--font-size--base);
    line-height: 1;
    text-transform: uppercase;
    margin: 0;
    color: var(--color-foreground);
  }

  .athlete-testimonials__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 500;
    font-size: 40px;
    line-height: 44px;
    letter-spacing: -1.2px;
    margin: 0;
    color: var(--color-foreground);
  }

  .athlete-testimonials__header-button {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 40px;
    border-radius: 24px;
    background-color: var(--color-accent);
    color: #FFFFFF;
    font-family: var(--font-body--family);
    font-weight: 700;
    font-size: var(--font-size--base);
    line-height: 20px;
    text-transform: uppercase;
    text-decoration: none;
    min-height: 48px;
    white-space: nowrap;
    flex-shrink: 0;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .athlete-testimonials__header-button:hover {
    opacity: 0.9;
  }

  .athlete-testimonials__grid {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .athlete-testimonials__card {
    position: relative;
    flex: 1;
    min-width: 0;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 350 / 526;
  }

  .athlete-testimonials__card-bg {
    position: absolute;
    inset: 0;
  }

  .athlete-testimonials__card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .athlete-testimonials__card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    justify-content: flex-end;
    padding: 16px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
    backdrop-filter: blur(4px);
  }

  .athlete-testimonials__quote {
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: 400;
    font-size: var(--font-size--xl);
    line-height: 28px;
    color: #FFFFFF;
    margin: 0;
  }

  .athlete-testimonials__card-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    justify-content: center;
  }

  .athlete-testimonials__name {
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 24px;
    line-height: 26px;
    color: #FFFFFF;
    margin: 0;
  }

  .athlete-testimonials__role {
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 12px;
    line-height: 14px;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .athlete-testimonials__header {
      flex-direction: column;
      align-items: flex-start;
    }

    .athlete-testimonials__heading {
      font-size: 32px;
      line-height: 35px;
      letter-spacing: -0.96px;
    }

    .athlete-testimonials__grid {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .athlete-testimonials__grid::-webkit-scrollbar {
      display: none;
    }

    .athlete-testimonials__card {
      flex: 0 0 80%;
      scroll-snap-align: start;
    }

    .athlete-testimonials__quote {
      font-size: var(--font-size--base);
      line-height: 22px;
    }

    .athlete-testimonials__name {
      font-size: 20px;
      line-height: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
