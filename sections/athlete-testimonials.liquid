<div class="athlete-testimonials color-{{ section.settings.color_scheme }}" style="--at-padding-top: {{ section.settings.padding_top }}px; --at-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="athlete-testimonials__inner">
    <div class="athlete-testimonials__header">
      <div class="athlete-testimonials__header-text">
        {%- if section.settings.subheading != blank -%}
          <p class="athlete-testimonials__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="athlete-testimonials__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="athlete-testimonials__header-button">
          <span>{{ section.settings.button_label }}</span>
        </a>
      {%- endif -%}
    </div>

    <div class="athlete-testimonials__grid">
      {%- for block in section.blocks -%}
        <div class="athlete-testimonials__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: block.settings.image.width
              | image_tag:
                sizes: '(min-width: 990px) 350px, 300px',
                widths: '300,350,600,700',
                loading: 'lazy',
                alt: block.settings.name | default: 'Athlete',
                class: 'athlete-testimonials__card-image'
            }}
          {%- endif -%}
          <div class="athlete-testimonials__card-overlay"></div>
          <div class="athlete-testimonials__card-content">
            {%- if block.settings.quote != blank -%}
              <p class="athlete-testimonials__quote">{{ block.settings.quote }}</p>
            {%- endif -%}
            <div class="athlete-testimonials__card-info">
              {%- if block.settings.name != blank -%}
                <p class="athlete-testimonials__name">{{ block.settings.name }}</p>
              {%- endif -%}
              {%- if block.settings.sport != blank -%}
                <p class="athlete-testimonials__sport">{{ block.settings.sport }}</p>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
.athlete-testimonials {
  padding-block-start: var(--at-padding-top, 64px);
  padding-block-end: var(--at-padding-bottom, 64px);
  padding-inline: 144px;
}

.athlete-testimonials__inner {
  display: flex;
  flex-direction: column;
  gap: 32px;
  max-width: 1152px;
  margin: 0 auto;
}

.athlete-testimonials__header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-end;
  gap: 32px;
}

.athlete-testimonials__header-text {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.athlete-testimonials__subheading {
  font-size: 16px;
  font-weight: 500;
  line-height: 16px;
  text-transform: uppercase;
  color: rgb(var(--color-foreground-heading));
  margin: 0;
}

.athlete-testimonials__heading {
  font-size: 40px;
  font-weight: 500;
  line-height: 44px;
  letter-spacing: -1.2px;
  text-transform: capitalize;
  color: rgb(var(--color-foreground-heading));
  margin: 0;
}

.athlete-testimonials__header-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 40px;
  background-color: #0033FF;
  color: #ffffff;
  border-radius: 24px;
  font-size: 16px;
  font-weight: 700;
  line-height: 20px;
  text-transform: uppercase;
  text-decoration: none;
  min-height: 48px;
  white-space: nowrap;
  flex-shrink: 0;
  transition: background-color 0.2s ease;
}

.athlete-testimonials__header-button:hover {
  background-color: #0029CC;
}

.athlete-testimonials__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  align-items: center;
}

.athlete-testimonials__card {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  aspect-ratio: 350 / 526;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.athlete-testimonials__card-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
}

.athlete-testimonials__card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
  backdrop-filter: blur(4px);
  z-index: 1;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.athlete-testimonials__card:hover .athlete-testimonials__card-overlay {
  opacity: 1;
}

.athlete-testimonials__card-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 12px;
  justify-content: flex-end;
  padding: 16px;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
  backdrop-filter: blur(4px);
}

.athlete-testimonials__quote {
  font-size: 20px;
  font-weight: 400;
  line-height: 28px;
  color: #ffffff;
  margin: 0;
}

.athlete-testimonials__card-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
  justify-content: center;
}

.athlete-testimonials__name {
  font-size: 24px;
  font-weight: 500;
  line-height: 26px;
  text-transform: capitalize;
  color: #ffffff;
  margin: 0;
}

.athlete-testimonials__sport {
  font-size: 12px;
  font-weight: 500;
  line-height: 14px;
  text-transform: uppercase;
  color: #ffffff;
  margin: 0;
}

@media screen and (max-width: 749px) {
  .athlete-testimonials {
    padding-inline: 16px;
    padding-block-start: var(--at-padding-top, 32px);
    padding-block-end: var(--at-padding-bottom, 32px);
  }

  .athlete-testimonials__header {
    flex-direction: column;
    align-items: flex-start;
  }

  .athlete-testimonials__heading {
    font-size: 32px;
    line-height: 35px;
    letter-spacing: -0.96px;
  }

  .athlete-testimonials__grid {
    display: flex;
    flex-direction: row;
    gap: 16px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
  }

  .athlete-testimonials__grid::-webkit-scrollbar {
    display: none;
  }

  .athlete-testimonials__card {
    flex-shrink: 0;
    width: 300px;
    aspect-ratio: 300 / 450;
    scroll-snap-align: start;
  }

  .athlete-testimonials__quote {
    font-size: 16px;
    line-height: 22px;
  }

  .athlete-testimonials__name {
    font-size: 20px;
    line-height: 22px;
  }
}
{% endstylesheet %}

