<div class="color-{{ section.settings.color_scheme }}">
  <div
    class="athlete-testimonials section--{{ section.settings.section_width }}"
    style="
      --padding-block-start: {{ section.settings.padding-block-start }}px;
      --padding-block-end: {{ section.settings.padding-block-end }}px;
    "
  >
    <div class="athlete-testimonials__header">
      <div class="athlete-testimonials__header-text">
        {% if section.settings.subtitle != blank %}
          <p class="athlete-testimonials__subtitle">{{ section.settings.subtitle | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="athlete-testimonials__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>
      {% if section.settings.button_label != blank %}
        <a
          {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% endif %}
          class="athlete-testimonials__header-button"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>

    <div class="athlete-testimonials__grid">
      {% for block in section.blocks %}
        {% if block.type == 'athlete-card' %}
          <div class="athlete-testimonials__card" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="athlete-testimonials__card-image">
                {{
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag:
                    sizes: '(min-width: 990px) 350px, (min-width: 750px) 300px, 280px',
                    widths: '280,300,350,526,700',
                    loading: 'lazy',
                    alt: block.settings.image.alt
                }}
              </div>
            {% endif %}
            <div class="athlete-testimonials__card-overlay">
              {% if block.settings.quote != blank %}
                <p class="athlete-testimonials__card-quote">{{ block.settings.quote }}</p>
              {% endif %}
              <div class="athlete-testimonials__card-info">
                {% if block.settings.athlete_name != blank %}
                  <p class="athlete-testimonials__card-name">{{ block.settings.athlete_name | escape }}</p>
                {% endif %}
                {% if block.settings.athlete_sport != blank %}
                  <span class="athlete-testimonials__card-sport">{{ block.settings.athlete_sport | escape }}</span>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .athlete-testimonials {
    padding-block-start: var(--padding-block-start, 64px);
    padding-block-end: var(--padding-block-end, 64px);
    padding-inline: var(--padding-md);
  }

  .athlete-testimonials.section--page-width {
    max-width: var(--page-width);
    margin-inline: auto;
  }

  .athlete-testimonials__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-block-end: 32px;
  }

  .athlete-testimonials__header-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .athlete-testimonials__subtitle {
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: var(--font-size--md);
    line-height: 16px;
    text-transform: uppercase;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  .athlete-testimonials__heading {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 40px;
    line-height: 44px;
    letter-spacing: -1.2px;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  .athlete-testimonials__header-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 40px;
    border-radius: 24px;
    background-color: #0033FF;
    color: #ffffff;
    font-family: var(--font-body--family);
    font-weight: 700;
    font-size: var(--font-size--md);
    line-height: 20px;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s ease;
    flex-shrink: 0;
  }

  .athlete-testimonials__header-button:hover {
    background-color: #0029CC;
  }

  .athlete-testimonials__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .athlete-testimonials__card {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 350 / 526;
  }

  .athlete-testimonials__card-image {
    position: absolute;
    inset: 0;
  }

  .athlete-testimonials__card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .athlete-testimonials__card-overlay {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    justify-content: flex-end;
    padding: 16px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    min-height: 44%;
  }

  .athlete-testimonials__card-quote {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: var(--font-size--xl);
    line-height: 28px;
    color: #ffffff;
    margin: 0;
  }

  .athlete-testimonials__card-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .athlete-testimonials__card-name {
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: var(--font-size--2xl);
    line-height: 26px;
    color: #ffffff;
    margin: 0;
  }

  .athlete-testimonials__card-sport {
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 12px;
    line-height: 14px;
    text-transform: uppercase;
    color: #ffffff;
  }

  @media screen and (max-width: 990px) {
    .athlete-testimonials__heading {
      font-size: 32px;
      line-height: 35px;
      letter-spacing: -0.96px;
    }

    .athlete-testimonials__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 16px;
      padding-block-end: 8px;
    }

    .athlete-testimonials__card {
      flex: 0 0 280px;
      scroll-snap-align: start;
      aspect-ratio: 300 / 450;
    }

    .athlete-testimonials__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .athlete-testimonials__header-button {
      width: 100%;
    }

    .athlete-testimonials__card-quote {
      font-size: var(--font-size--md);
      line-height: 22px;
    }

    .athlete-testimonials__card-name {
      font-size: var(--font-size--xl);
      line-height: 24px;
    }
  }

  @media screen and (max-width: 750px) {
    .athlete-testimonials {
      padding-inline: var(--padding-sm);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.athlete_testimonials",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "athlete-card",
      "name": "Athlete card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "athlete_name",
          "label": "Athlete name"
        },
        {
          "type": "text",
          "id": "athlete_sport",
          "label": "Sport"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Our Athletes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Validated by Leading Athletes"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "ADD TO CART"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-8"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
