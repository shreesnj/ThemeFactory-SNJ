<div class="cta-banner color-{{ section.settings.color_scheme }}" style="--cta-padding-top: {{ section.settings.padding_top }}px; --cta-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="cta-banner__inner">
    {%- if section.settings.image != blank -%}
      <div class="cta-banner__image-wrapper">
        <div class="cta-banner__image-clip">
          {{
            section.settings.image
            | image_url: width: section.settings.image.width
            | image_tag:
              sizes: '(min-width: 990px) 381px, calc(100vw - 32px)',
              widths: '334,381,668,762',
              loading: 'lazy',
              alt: section.settings.image.alt | default: section.settings.heading,
              class: 'cta-banner__image'
          }}
        </div>
      </div>
    {%- endif -%}

    <div class="cta-banner__content">
      {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
        <div class="cta-banner__text-group">
          <h2 class="cta-banner__heading">
            {%- if section.settings.heading != blank -%}
              {{ section.settings.heading }}
            {%- endif -%}
            {%- if section.settings.heading_accent != blank -%}
              <br><span class="cta-banner__heading-accent">{{ section.settings.heading_accent }}</span>
            {%- endif -%}
          </h2>
          {%- if section.settings.description != blank -%}
            <p class="cta-banner__description">{{ section.settings.description }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="cta-banner__button">
          <span>{{ section.settings.button_label }}</span>
          <img src="{{ 'solar-arrow-up-linear.svg' | asset_url }}" alt="" width="32" height="32" class="cta-banner__button-icon">
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
.cta-banner {
  padding-block-start: var(--cta-padding-top, 64px);
  padding-block-end: var(--cta-padding-bottom, 64px);
  background-color: #F7F7F7;
}

.cta-banner__inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 36px;
  max-width: 1200px;
  margin: 0 auto;
  padding-inline: 64px;
}

.cta-banner__image-wrapper {
  flex-shrink: 0;
  width: 381px;
}

.cta-banner__image-clip {
  border-radius: 12px;
  overflow: hidden;
  height: 330px;
}

.cta-banner__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
}

.cta-banner__content {
  display: flex;
  flex-direction: column;
  gap: 24px;
  max-width: 584px;
}

.cta-banner__text-group {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.cta-banner__heading {
  font-size: 40px;
  font-weight: 500;
  line-height: 44px;
  letter-spacing: -1.2px;
  color: rgb(var(--color-foreground-heading));
  margin: 0;
}

.cta-banner__heading-accent {
  color: #0033FF;
}

.cta-banner__description {
  font-size: 16px;
  font-weight: 400;
  line-height: 22px;
  letter-spacing: 0.16px;
  color: #0B0B0B;
  margin: 0;
}

.cta-banner__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 2px;
  padding: 8px 40px;
  background-color: #0033FF;
  color: #ffffff;
  border-radius: 24px;
  font-size: 16px;
  font-weight: 700;
  line-height: 20px;
  text-transform: uppercase;
  text-decoration: none;
  min-height: 48px;
  width: fit-content;
  transition: background-color 0.2s ease;
}

.cta-banner__button:hover {
  background-color: #0029CC;
}

.cta-banner__button-icon {
  width: 32px;
  height: 32px;
  transform: rotate(45deg);
  filter: brightness(0) invert(1);
}

@media screen and (max-width: 749px) {
  .cta-banner__inner {
    flex-direction: column;
    padding-inline: 16px;
    gap: 24px;
  }

  .cta-banner__image-wrapper {
    width: 100%;
  }

  .cta-banner__image-clip {
    height: 280px;
  }

  .cta-banner__heading {
    font-size: 32px;
    line-height: 35px;
    letter-spacing: -0.96px;
  }

  .cta-banner__content {
    max-width: 100%;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.cta_banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Path to Living an Enhanced Life Starts Here."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent text",
      "default": "Enhanced Life Starts Here."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "A custom formula designed to help you exceed your potential."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "CREATE YOUR FORMULA"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 64,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:names.cta_banner"
    }
  ]
}
{% endschema %}
