<div
  class="doctor-rec section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-top: {{ section.settings.padding_block_start }}px;
    --section-padding-bottom: {{ section.settings.padding_block_end }}px;
    --doctor-gap: {{ section.settings.gap }}px;
  "
>
  <div class="doctor-rec__grid">
    <div class="doctor-rec__left">
      {% if section.settings.subtitle != blank %}
        <p class="doctor-rec__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="doctor-rec__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.doctor_image != blank or section.settings.doctor_text != blank %}
        <div class="doctor-rec__chip">
          {% if section.settings.doctor_image != blank %}
            <div class="doctor-rec__chip-avatar">
              {{
                section.settings.doctor_image
                | image_url: width: 96
                | image_tag:
                  loading: 'lazy',
                  class: 'doctor-rec__chip-img',
                  alt: section.settings.doctor_text
              }}
              <div class="doctor-rec__chip-check">
                <svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M1 4L3 6L7 2" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>
          {% endif %}
          {% if section.settings.doctor_text != blank %}
            <p class="doctor-rec__chip-text">{{ section.settings.doctor_text }}</p>
          {% endif %}
        </div>
      {% endif %}
      {% if section.settings.main_image != blank %}
        <div class="doctor-rec__main-image">
          {{
            section.settings.main_image
            | image_url: width: section.settings.main_image.width
            | image_tag:
              sizes: '(min-width: 750px) 50vw, 100vw',
              widths: '375,550,750,1000,1200',
              loading: 'lazy',
              class: 'doctor-rec__img',
              alt: section.settings.heading
          }}
        </div>
      {% endif %}
    </div>
    <div class="doctor-rec__right">
      <div class="doctor-rec__items">
        {% for block in section.blocks %}
          <a
            {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
            class="doctor-rec__item"
            {{ block.shopify_attributes }}
          >
            <div class="doctor-rec__item-img">
              {% if block.settings.product_image != blank %}
                {{
                  block.settings.product_image
                  | image_url: width: 180
                  | image_tag:
                    loading: 'lazy',
                    class: 'doctor-rec__item-thumb',
                    alt: block.settings.product_title
                }}
              {% endif %}
            </div>
            <div class="doctor-rec__item-content">
              <div class="doctor-rec__item-title-row">
                {% if block.settings.show_plus_icon %}
                  <span class="doctor-rec__item-plus">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M7 1V13M1 7H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                {% endif %}
                {% if block.settings.product_title != blank %}
                  <span class="doctor-rec__item-name">{{ block.settings.product_title }}</span>
                {% endif %}
              </div>
              {% if block.settings.product_description != blank %}
                <p class="doctor-rec__item-desc">{{ block.settings.product_description }}</p>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.doctor-rec {
  padding-block-start: var(--section-padding-top, 80px);
  padding-block-end: var(--section-padding-bottom, 80px);
  padding-inline: calc(120px * var(--spacing-scale, 1));
  background-color: var(--color-background);
}

.doctor-rec__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--doctor-gap, 24px);
  align-items: center;
  max-width: 1200px;
  margin: 0 auto;
}

.doctor-rec__left {
  display: flex;
  flex-direction: column;
  gap: 20px;
  justify-content: center;
}

.doctor-rec__subtitle {
  font-family: var(--font-custom-cta), sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 16px;
  letter-spacing: 0.75px;
  text-transform: uppercase;
  color: #767676;
  margin: 0;
}

.doctor-rec__heading {
  font-family: var(--font-custom-serif), serif;
  font-weight: 400;
  font-size: 48px;
  line-height: 52px;
  letter-spacing: -1px;
  color: #767676;
  margin: 0;
}

.doctor-rec__chip {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  background-color: #F5F5F5;
  border-radius: 8px;
}

.doctor-rec__chip-avatar {
  position: relative;
  flex-shrink: 0;
}

.doctor-rec__chip-img {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
}

.doctor-rec__chip-check {
  position: absolute;
  bottom: -2px;
  right: -2px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background-color: #414141;
  display: flex;
  align-items: center;
  justify-content: center;
}

.doctor-rec__chip-text {
  font-family: var(--font-custom-heading), sans-serif;
  font-weight: 500;
  font-size: 16px;
  line-height: 20px;
  color: #767676;
  margin: 0;
}

.doctor-rec__main-image {
  width: 100%;
}

.doctor-rec__img {
  width: 100%;
  height: auto;
  object-fit: cover;
  border-radius: 8px;
}

.doctor-rec__right {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.doctor-rec__items {
  display: flex;
  flex-direction: column;
}

.doctor-rec__item {
  display: flex;
  gap: 4px;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px solid #D9D9DB;
  text-decoration: none;
  color: inherit;
}

.doctor-rec__item:last-child {
  border-bottom: 1px solid #D9D9DB;
}

.doctor-rec__item:hover {
  opacity: 0.85;
}

.doctor-rec__item-img {
  flex-shrink: 0;
  width: 90px;
  height: 92px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.doctor-rec__item-thumb {
  max-width: 100%;
  max-height: 80px;
  object-fit: contain;
}

.doctor-rec__item-content {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
  padding: 8px 12px;
}

.doctor-rec__item-title-row {
  display: flex;
  gap: 4px;
  align-items: center;
}

.doctor-rec__item-plus {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  color: #414141;
  flex-shrink: 0;
}

.doctor-rec__item-name {
  font-family: var(--font-custom-heading), sans-serif;
  font-weight: 700;
  font-size: 18px;
  line-height: 24px;
  color: #414141;
}

.doctor-rec__item-desc {
  font-family: var(--font-custom-serif), serif;
  font-weight: 400;
  font-size: 18px;
  line-height: 24px;
  letter-spacing: -0.5px;
  color: #767676;
  margin: 0;
}

@media screen and (max-width: 749px) {
  .doctor-rec {
    padding-inline: 12px;
    padding-block-start: 48px;
    padding-block-end: 48px;
  }

  .doctor-rec__grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .doctor-rec__heading {
    font-size: 32px;
    line-height: 36px;
  }

  .doctor-rec__chip-text {
    font-size: 14px;
    line-height: 18px;
  }

  .doctor-rec__item-name {
    font-size: 16px;
    line-height: 20px;
  }

  .doctor-rec__item-desc {
    font-size: 16px;
    line-height: 20px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.doctor_recommended",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:settings.subtitle",
      "default": "Cardiologist recommended"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Heart health made easy with one routine."
    },
    {
      "type": "image_picker",
      "id": "doctor_image",
      "label": "t:settings.doctor_image"
    },
    {
      "type": "text",
      "id": "doctor_text",
      "label": "t:settings.doctor_text",
      "default": "Our Chief Cardiologist, Dr. Christopher Davis, MD recommends this for daily heart support."
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "t:settings.main_image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 24,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "product-item",
      "name": "t:names.product_item",
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "t:settings.hero_image"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "t:settings.product_title",
          "default": "SuperBeets® Heart Chews"
        },
        {
          "type": "textarea",
          "id": "product_description",
          "label": "t:settings.product_description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.link"
        },
        {
          "type": "checkbox",
          "id": "show_plus_icon",
          "label": "t:settings.show_plus_icon",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.doctor_recommended",
      "blocks": [
        {
          "type": "product-item",
          "settings": {
            "product_title": "SuperBeets® Heart Chews"
          }
        }
      ]
    }
  ]
}
{% endschema %}
