{% liquid
  assign section_id = section.id
  assign bg_image = section.settings.background_image
  assign bg_image_mobile = section.settings.background_image_mobile
%}

<footer
  id="section-{{ section_id }}"
  class="custom-footer color-{{ section.settings.color_scheme }}"
  role="contentinfo"
  style="
    --custom-footer-padding-top: {{ section.settings.padding-block-start }}px;
    --custom-footer-padding-bottom: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="custom-footer__background">
    {% if bg_image != blank %}
      <picture>
        {% if bg_image_mobile != blank %}
          <source
            media="(min-width: 750px)"
            srcset="{{ bg_image | image_url: width: bg_image.width }}"
          >
          {{
            bg_image_mobile
            | image_url: width: bg_image_mobile.width
            | image_tag:
              loading: 'lazy',
              sizes: '100vw',
              widths: '375,550,750,1100,1500',
              class: 'custom-footer__bg-image',
              alt: 'Footer background'
          }}
        {% else %}
          {{
            bg_image
            | image_url: width: bg_image.width
            | image_tag:
              loading: 'lazy',
              sizes: '100vw',
              widths: '375,550,750,1100,1500,1780,2000',
              class: 'custom-footer__bg-image',
              alt: 'Footer background'
          }}
        {% endif %}
      </picture>
    {% endif %}
  </div>

  <div class="custom-footer__inner">
    {%- comment -%} Navigation area {%- endcomment -%}
    <div class="custom-footer__nav">
      <div class="custom-footer__nav-left">
        {%- comment -%} Explore products column {%- endcomment -%}
        <div class="custom-footer__column custom-footer__column--explore">
          {% if section.settings.heading_explore != blank %}
            <h3 class="custom-footer__heading">{{ section.settings.heading_explore | escape }}</h3>
          {% endif %}
          <div class="custom-footer__product-logos">
            {% if section.settings.product_logo_1 != blank %}
              <a {% if section.settings.product_link_1 != blank %}href="{{ section.settings.product_link_1 }}"{% endif %} class="custom-footer__product-link">
                {{
                  section.settings.product_logo_1
                  | image_url: width: 300
                  | image_tag:
                    loading: 'lazy',
                    class: 'custom-footer__product-logo',
                    alt: section.settings.product_logo_1.alt
                }}
              </a>
            {% endif %}
            {% if section.settings.product_logo_2 != blank %}
              <a {% if section.settings.product_link_2 != blank %}href="{{ section.settings.product_link_2 }}"{% endif %} class="custom-footer__product-link">
                {{
                  section.settings.product_logo_2
                  | image_url: width: 300
                  | image_tag:
                    loading: 'lazy',
                    class: 'custom-footer__product-logo',
                    alt: section.settings.product_logo_2.alt
                }}
              </a>
            {% endif %}
            {% if section.settings.product_logo_3 != blank %}
              <a {% if section.settings.product_link_3 != blank %}href="{{ section.settings.product_link_3 }}"{% endif %} class="custom-footer__product-link">
                {{
                  section.settings.product_logo_3
                  | image_url: width: 300
                  | image_tag:
                    loading: 'lazy',
                    class: 'custom-footer__product-logo',
                    alt: section.settings.product_logo_3.alt
                }}
              </a>
            {% endif %}
          </div>
        </div>

        {%- comment -%} Company column {%- endcomment -%}
        <div class="custom-footer__column custom-footer__column--company">
          {% if section.settings.heading_company != blank %}
            <h3 class="custom-footer__heading">{{ section.settings.heading_company | escape }}</h3>
          {% endif %}
          {% if section.settings.company_menu != blank %}
            <ul class="custom-footer__menu">
              {% for link in linklists[section.settings.company_menu].links %}
                <li class="custom-footer__menu-item">
                  <a href="{{ link.url }}" class="custom-footer__menu-link">{{ link.title | escape }}</a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>

      {%- comment -%} Mobile disclaimer (between nav and contact on mobile) {%- endcomment -%}
      <div class="custom-footer__disclaimer custom-footer__disclaimer--mobile">
        {% if section.settings.disclaimer_text != blank %}
          <div class="custom-footer__disclaimer-content">
            <svg class="custom-footer__disclaimer-icon" width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M5 0V10" stroke="currentColor" stroke-width="1.2"/>
              <path d="M0 5H10" stroke="currentColor" stroke-width="1.2"/>
            </svg>
            <p class="custom-footer__disclaimer-text">{{ section.settings.disclaimer_text | escape }}</p>
          </div>
        {% endif %}
      </div>

      {%- comment -%} Get in touch column {%- endcomment -%}
      <div class="custom-footer__column custom-footer__column--contact">
        {% if section.settings.heading_contact != blank %}
          <h3 class="custom-footer__heading">{{ section.settings.heading_contact | escape }}</h3>
        {% endif %}
        <div class="custom-footer__social-icons">
          {% if section.settings.facebook_url != blank %}
            <a href="{{ section.settings.facebook_url }}" class="custom-footer__social-link" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true">
                {% render 'icon', icon: 'facebook' %}
              </svg>
            </a>
          {% endif %}
          {% if section.settings.pinterest_url != blank %}
            <a href="{{ section.settings.pinterest_url }}" class="custom-footer__social-link" aria-label="Pinterest" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true">
                {% render 'icon', icon: 'pinterest' %}
              </svg>
            </a>
          {% endif %}
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" class="custom-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true">
                {% render 'icon', icon: 'instagram' %}
              </svg>
            </a>
          {% endif %}
          {% if section.settings.tiktok_url != blank %}
            <a href="{{ section.settings.tiktok_url }}" class="custom-footer__social-link" aria-label="TikTok" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true">
                {% render 'icon', icon: 'tiktok' %}
              </svg>
            </a>
          {% endif %}
        </div>
        <div class="custom-footer__contact-info">
          {% if section.settings.contact_email != blank %}
            <p class="custom-footer__contact-email">{{ section.settings.contact_email | escape }}</p>
          {% endif %}
          {% if section.settings.contact_description != blank %}
            <p class="custom-footer__contact-description">{{ section.settings.contact_description | escape }}</p>
          {% endif %}
        </div>
      </div>
    </div>

    {%- comment -%} Desktop disclaimer {%- endcomment -%}
    <div class="custom-footer__disclaimer custom-footer__disclaimer--desktop">
      {% if section.settings.disclaimer_text != blank %}
        <div class="custom-footer__disclaimer-content">
          <svg class="custom-footer__disclaimer-icon" width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M5 0V10" stroke="currentColor" stroke-width="1.2"/>
            <path d="M0 5H10" stroke="currentColor" stroke-width="1.2"/>
          </svg>
          <p class="custom-footer__disclaimer-text">{{ section.settings.disclaimer_text | escape }}</p>
        </div>
      {% endif %}
    </div>

    {%- comment -%} Legal area: policies + copyright {%- endcomment -%}
    <div class="custom-footer__legal">
      <div class="custom-footer__policies">
        {% for policy in shop.policies %}
          {% if policy != blank %}
            <a href="{{ policy.url }}" class="custom-footer__policy-link">{{ policy.title }}</a>
          {% endif %}
        {% endfor %}
      </div>
      {% if section.settings.copyright_text != blank %}
        <p class="custom-footer__copyright">{{ section.settings.copyright_text | escape }}</p>
      {% endif %}
    </div>

    {%- comment -%} Brand logo {%- endcomment -%}
    <div class="custom-footer__brand-logo">
      {% if section.settings.footer_logo != blank %}
        {{
          section.settings.footer_logo
          | image_url: width: section.settings.footer_logo.width
          | image_tag:
            loading: 'lazy',
            sizes: '100vw',
            widths: '375,550,750,1100,1500',
            class: 'custom-footer__logo-img',
            alt: shop.name
        }}
      {% else %}
        <img
          src="{{ 'logos.svg' | asset_url }}"
          alt="{{ shop.name | escape }}"
          class="custom-footer__logo-img"
          loading="lazy"
          width="346"
          height="37"
        >
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
.custom-footer {
  --footer-color-heading: #A6A6A6;
  --footer-color-text: #FFFFFF;
  --footer-color-legal: #E4E4E4;

  position: relative;
  overflow: hidden;
  border-radius: 12px;
  padding-block-start: var(--custom-footer-padding-top, 32px);
  padding-block-end: var(--custom-footer-padding-bottom, 32px);
  padding-inline: 32px;
  color: var(--footer-color-text);
}

.custom-footer__background {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.custom-footer__bg-image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.custom-footer__inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 54px;
}

/* Nav area */
.custom-footer__nav {
  display: flex;
  justify-content: space-between;
}

.custom-footer__nav-left {
  display: flex;
  gap: 64px;
}

.custom-footer__column {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.custom-footer__heading {
  font-family: var(--font-body--family);
  font-size: 14px;
  line-height: 17px;
  letter-spacing: -0.56px;
  font-weight: 400;
  color: var(--footer-color-heading);
  margin: 0;
}

/* Product logos */
.custom-footer__product-logos {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.custom-footer__product-link {
  display: inline-block;
  text-decoration: none;
}

.custom-footer__product-logo {
  display: block;
  height: auto;
  max-width: 175px;
}

/* Company menu */
.custom-footer__menu {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.custom-footer__menu-item {
  margin: 0;
  padding: 0;
}

.custom-footer__menu-link {
  font-family: var(--font-subheading--family, var(--font-body--family));
  font-size: 14px;
  line-height: 17px;
  font-weight: 500;
  color: var(--footer-color-text);
  text-decoration: none;
}

.custom-footer__menu-link:hover {
  opacity: 0.8;
}

/* Contact column */
.custom-footer__column--contact {
  gap: 24px;
}

.custom-footer__social-icons {
  display: flex;
  gap: 32px;
  align-items: center;
}

.custom-footer__social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--footer-color-text);
  text-decoration: none;
}

.custom-footer__social-link:hover {
  opacity: 0.8;
}

.custom-footer__social-link svg {
  width: 20px;
  height: 20px;
}

.custom-footer__contact-info {
  display: flex;
  flex-direction: column;
  gap: 6px;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
  padding-top: 24px;
}

.custom-footer__contact-email {
  font-family: var(--font-body--family);
  font-size: 16px;
  line-height: 16px;
  font-weight: 500;
  color: var(--footer-color-text);
  margin: 0;
}

.custom-footer__contact-description {
  font-family: var(--font-body--family);
  font-size: 12px;
  line-height: 17px;
  font-weight: 400;
  color: var(--footer-color-text);
  margin: 0;
}

/* Disclaimer */
.custom-footer__disclaimer--mobile {
  display: none;
}

.custom-footer__disclaimer-content {
  display: flex;
  align-items: center;
  gap: 6px;
}

.custom-footer__disclaimer-icon {
  flex-shrink: 0;
  color: var(--footer-color-text);
}

.custom-footer__disclaimer-text {
  font-family: var(--font-body--family);
  font-size: 12px;
  line-height: 17px;
  font-weight: 400;
  color: var(--footer-color-text);
  margin: 0;
}

/* Legal area */
.custom-footer__legal {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.custom-footer__policies {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
  align-items: center;
}

.custom-footer__policy-link {
  font-family: var(--font-body--family);
  font-size: 12px;
  line-height: 12px;
  font-weight: 400;
  color: var(--footer-color-legal);
  text-decoration: none;
}

.custom-footer__policy-link:hover {
  opacity: 0.8;
}

.custom-footer__copyright {
  font-family: var(--font-body--family);
  font-size: 12px;
  line-height: 12px;
  font-weight: 400;
  color: var(--footer-color-legal);
  margin: 0;
}

/* Brand logo */
.custom-footer__brand-logo {
  width: 100%;
}

.custom-footer__logo-img {
  display: block;
  width: 100%;
  height: auto;
}

/* Mobile styles */
@media screen and (max-width: 749px) {
  .custom-footer {
    border-radius: 8px;
    padding: 16px 16px 32px 16px;
  }

  .custom-footer__inner {
    gap: 40px;
  }

  .custom-footer__nav {
    flex-direction: column;
    gap: 24px;
  }

  .custom-footer__nav-left {
    gap: 32px;
  }

  .custom-footer__disclaimer--desktop {
    display: none;
  }

  .custom-footer__disclaimer--mobile {
    display: block;
  }

  .custom-footer__disclaimer-content {
    gap: 8px;
    align-items: center;
  }

  .custom-footer__column--contact {
    gap: 12px;
  }

  .custom-footer__contact-info {
    border-top: none;
    padding-top: 0;
  }

  .custom-footer__policy-link {
    color: var(--footer-color-text);
  }

  .custom-footer__copyright {
    color: var(--footer-color-text);
  }
}
{% endstylesheet %}

{% schema %}
