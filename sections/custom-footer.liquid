      "label": "t:settings.product_logo_1"
    },
    {
      "type": "url",
      "id": "product_link_1",
      "label": "t:settings.product_link_1"
    },
    {
      "type": "image_picker",
      "id": "product_logo_2",
      "label": "t:settings.product_logo_2"
    },
    {
      "type": "url",
      "id": "product_link_2",
      "label": "t:settings.product_link_2"
    },
    {
      "type": "image_picker",
      "id": "product_logo_3",
      "label": "t:settings.product_logo_3"
    },
    {
      "type": "url",
      "id": "product_link_3",
      "label": "t:settings.product_link_3"
    },
    {
      "type": "text",
      "id": "heading_company",
      "label": "t:settings.heading_company",
      "default": "Company"
    },
    {
      "type": "link_list",
      "id": "company_menu",
      "label": "t:settings.company_menu"
    },
    {
      "type": "header",
      "content": "t:content.contact"
