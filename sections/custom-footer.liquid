{% liquid
  assign section_id = section.id
%}

<footer
  id="section-{{ section_id }}"
  class="snj-footer color-{{ section.settings.color_scheme }}"
  role="contentinfo"
  style="--snj-footer-padding-top: {{ section.settings.padding-block-start }}px; --snj-footer-padding-bottom: {{ section.settings.padding-block-end }}px;"
>
  <div class="snj-footer__container">
    {%- comment -%} ─── Background image ─── {%- endcomment -%}
    {% if section.settings.background_image != blank or section.settings.background_image_mobile != blank %}
      <picture class="snj-footer__bg">
        {% if section.settings.background_image != blank %}
          <source media="(min-width: 750px)" srcset="{{ section.settings.background_image | image_url: width: 1500 }}">
        {% endif %}
        {% if section.settings.background_image_mobile != blank %}
          <img
            src="{{ section.settings.background_image_mobile | image_url: width: 750 }}"
            alt=""
            class="snj-footer__bg-img"
            loading="lazy"
            width="{{ section.settings.background_image_mobile.width }}"
            height="{{ section.settings.background_image_mobile.height }}"
          >
        {% elsif section.settings.background_image != blank %}
          <img
            src="{{ section.settings.background_image | image_url: width: 1500 }}"
            alt=""
            class="snj-footer__bg-img"
            loading="lazy"
            width="{{ section.settings.background_image.width }}"
            height="{{ section.settings.background_image.height }}"
          >
        {% endif %}
      </picture>
    {% endif %}

    <div class="snj-footer__inner">

      {%- comment -%} ─── Navigation columns (Explore products + Company) ─── {%- endcomment -%}
      <div class="snj-footer__nav-columns">

        {%- comment -%} Explore products column {%- endcomment -%}
        <div class="snj-footer__column snj-footer__column--explore">
          {% if section.settings.heading_explore != blank %}
            <p class="snj-footer__column-label">{{ section.settings.heading_explore | escape }}</p>
          {% endif %}
          <div class="snj-footer__brand-logos">
            {% if section.settings.brand_logo_1 != blank %}
              {% if section.settings.product_link_1 != blank %}
                <a href="{{ section.settings.product_link_1 }}" class="snj-footer__brand-logo-link">
              {% endif %}
              <img
                src="{{ section.settings.brand_logo_1 | image_url: width: 300 }}"
                alt="{{ section.settings.brand_logo_1.alt | default: 'Brand logo' | escape }}"
                class="snj-footer__brand-logo-img"
                loading="lazy"
                width="{{ section.settings.brand_logo_1.width }}"
                height="{{ section.settings.brand_logo_1.height }}"
              >
              {% if section.settings.product_link_1 != blank %}
                </a>
              {% endif %}
            {% else %}
              {% if section.settings.product_link_1 != blank %}
                <a href="{{ section.settings.product_link_1 }}" class="snj-footer__brand-logo-link">
              {% endif %}
              <img
                src="{{ 'liveenhanced-1.svg' | asset_url }}"
                alt="LIVEENHANCED"
                class="snj-footer__brand-logo-img snj-footer__brand-logo-img--invert"
                loading="lazy"
                width="117"
                height="12"
              >
              {% if section.settings.product_link_1 != blank %}
                </a>
              {% endif %}
            {% endif %}

            {% if section.settings.brand_logo_2 != blank %}
              {% if section.settings.product_link_2 != blank %}
                <a href="{{ section.settings.product_link_2 }}" class="snj-footer__brand-logo-link">
              {% endif %}
              <img
                src="{{ section.settings.brand_logo_2 | image_url: width: 300 }}"
                alt="{{ section.settings.brand_logo_2.alt | default: 'Brand logo' | escape }}"
                class="snj-footer__brand-logo-img"
                loading="lazy"
                width="{{ section.settings.brand_logo_2.width }}"
                height="{{ section.settings.brand_logo_2.height }}"
              >
              {% if section.settings.product_link_2 != blank %}
                </a>
              {% endif %}
            {% endif %}

            {% if section.settings.brand_logo_3 != blank %}
              {% if section.settings.product_link_3 != blank %}
                <a href="{{ section.settings.product_link_3 }}" class="snj-footer__brand-logo-link">
              {% endif %}
              <img
                src="{{ section.settings.brand_logo_3 | image_url: width: 300 }}"
                alt="{{ section.settings.brand_logo_3.alt | default: 'Brand logo' | escape }}"
                class="snj-footer__brand-logo-img"
                loading="lazy"
                width="{{ section.settings.brand_logo_3.width }}"
                height="{{ section.settings.brand_logo_3.height }}"
              >
              {% if section.settings.product_link_3 != blank %}
                </a>
              {% endif %}
            {% endif %}
          </div>
        </div>

        {%- comment -%} Company column {%- endcomment -%}
        <div class="snj-footer__column snj-footer__column--company">
          {% if section.settings.heading_company != blank %}
            <p class="snj-footer__column-label">{{ section.settings.heading_company | escape }}</p>
          {% endif %}
          {% if section.settings.link_list_company != blank %}
            <ul class="snj-footer__link-list">
              {% for link in linklists[section.settings.link_list_company].links %}
                <li><a href="{{ link.url }}" class="snj-footer__link">{{ link.title | escape }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>

      {%- comment -%} ─── Disclaimer ─── {%- endcomment -%}
      {% if section.settings.show_disclaimer and section.settings.disclaimer_text != blank %}
        <div class="snj-footer__disclaimer">
          <svg class="snj-footer__disclaimer-icon" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M5 0V10" stroke="white" stroke-width="1.5"/>
            <path d="M0 5H10" stroke="white" stroke-width="1.5"/>
          </svg>
          <p class="snj-footer__disclaimer-text">{{ section.settings.disclaimer_text | escape }}</p>
        </div>
      {% endif %}

      {%- comment -%} ─── Get in touch ─── {%- endcomment -%}
      <div class="snj-footer__contact">
        {% if section.settings.heading_get_in_touch != blank %}
          <p class="snj-footer__column-label">{{ section.settings.heading_get_in_touch | escape }}</p>
        {% endif %}

        <div class="snj-footer__social">
          {% if section.settings.facebook_url != blank %}
            <a href="{{ section.settings.facebook_url }}" class="snj-footer__social-link" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
              <img src="{{ 'frame.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy">
            </a>
          {% endif %}
          {% if section.settings.pinterest_url != blank %}
            <a href="{{ section.settings.pinterest_url }}" class="snj-footer__social-link" aria-label="Pinterest" target="_blank" rel="noopener noreferrer">
              <img src="{{ 'frame-2.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy">
            </a>
          {% endif %}
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" class="snj-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
              <img src="{{ 'frame-3.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy">
            </a>
          {% endif %}
          {% if section.settings.tiktok_url != blank %}
            <a href="{{ section.settings.tiktok_url }}" class="snj-footer__social-link" aria-label="TikTok" target="_blank" rel="noopener noreferrer">
              <img src="{{ 'frame-4.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy">
            </a>
          {% endif %}
        </div>

        <div class="snj-footer__media-info">
          {% if section.settings.media_email != blank %}
            <p class="snj-footer__media-email">{{ section.settings.media_email | escape }}</p>
          {% endif %}
          {% if section.settings.media_description != blank %}
            <p class="snj-footer__media-desc">{{ section.settings.media_description | escape }}</p>
          {% endif %}
        </div>
      </div>

      {%- comment -%} ─── Legal (policies + copyright) ─── {%- endcomment -%}
      <div class="snj-footer__legal">
        {% if section.settings.link_list_policies != blank %}
          <div class="snj-footer__policies">
            {% for link in linklists[section.settings.link_list_policies].links %}
              <a href="{{ link.url }}" class="snj-footer__policy-link">{{ link.title | escape }}</a>
            {% endfor %}
          </div>
        {% endif %}
        {% if section.settings.copyright_text != blank %}
          <p class="snj-footer__copyright">{{ section.settings.copyright_text | escape }}</p>
        {% endif %}
      </div>

      {%- comment -%} ─── Large ENHANCED logo ─── {%- endcomment -%}
      <div class="snj-footer__large-logo">
        {% if section.settings.footer_logo != blank %}
          <img
            src="{{ section.settings.footer_logo | image_url: width: 1400 }}"
            alt="{{ shop.name | escape }}"
            class="snj-footer__large-logo-img"
            loading="lazy"
          >
        {% else %}
          <img
            src="{{ 'logos.svg' | asset_url }}"
            alt="{{ shop.name | escape }}"
            class="snj-footer__large-logo-img snj-footer__large-logo-img--invert"
            loading="lazy"
            width="346"
            height="37"
          >
        {% endif %}
      </div>

    </div>
  </div>
</footer>

{% stylesheet %}
/* ============================================================
   SNJ Footer — Enhanced Redesign
   Desktop: 12px radius, 32px padding, grid layout
   Mobile: 8px radius, 16px/32px padding, flex column
   ============================================================ */

.snj-footer {
  color: #ffffff;
  font-family: var(--font-body--family);
  padding-top: var(--snj-footer-padding-top, 0px);
  padding-bottom: var(--snj-footer-padding-bottom, 0px);
}

/* ── Container with background image ── */
.snj-footer__container {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  padding: 32px;
  background-color: #0d0d1a;
}

.snj-footer__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.snj-footer__bg-img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ── Inner layout — CSS Grid on desktop ── */
.snj-footer__inner {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr auto;
  row-gap: 54px;
  grid-template-areas:
    "nav contact"
    "disclaimer disclaimer"
    "legal legal"
    "logo logo";
}

/* ── Navigation columns ── */
.snj-footer__nav-columns {
  grid-area: nav;
  display: flex;
  gap: 64px;
}

.snj-footer__column {
  display: flex;
  flex-direction: column;
  gap: 24px;
  overflow: hidden;
}

.snj-footer__column-label {
  font-family: var(--font-body--family);
  font-size: 14px;
  font-weight: 400;
  line-height: 17px;
  letter-spacing: -0.56px;
  color: #A6A6A6;
  margin: 0;
}

/* ── Brand logos (Explore products) ── */
.snj-footer__brand-logos {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.snj-footer__brand-logo-link {
  display: block;
  text-decoration: none;
}

.snj-footer__brand-logo-link:hover {
  opacity: 0.8;
}

.snj-footer__brand-logo-img {
  display: block;
  height: auto;
  max-width: 175px;
}

.snj-footer__brand-logo-img--invert {
  filter: brightness(0) invert(1);
}

/* ── Company links ── */
.snj-footer__link-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.snj-footer__link-list li {
  margin: 0;
  padding: 0;
}

.snj-footer__link {
  font-family: var(--font-body--family);
  font-size: 14px;
  font-weight: 500;
  line-height: 17px;
  color: #ffffff;
  text-decoration: none;
  display: block;
}

.snj-footer__link:hover {
  opacity: 0.7;
}

/* ── Contact / Get in touch ── */
.snj-footer__contact {
  grid-area: contact;
  display: flex;
  flex-direction: column;
  gap: 24px;
  overflow: hidden;
}

.snj-footer__social {
  display: flex;
  align-items: center;
  gap: 32px;
}

.snj-footer__social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  color: #ffffff;
  text-decoration: none;
}

.snj-footer__social-link:hover {
  opacity: 0.7;
}

.snj-footer__social-link img {
  display: block;
  width: 20px;
  height: 20px;
}

.snj-footer__media-info {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.snj-footer__media-email {
  font-family: var(--font-body--family);
  font-size: 16px;
  font-weight: 500;
  line-height: 16px;
  color: #ffffff;
  margin: 0;
}

.snj-footer__media-desc {
  font-family: var(--font-body--family);
  font-size: 12px;
  font-weight: 400;
  line-height: 17px;
  color: #ffffff;
  margin: 0;
}

/* ── Disclaimer ── */
.snj-footer__disclaimer {
  grid-area: disclaimer;
  display: flex;
  align-items: center;
  gap: 6px;
}

.snj-footer__disclaimer-icon {
  flex-shrink: 0;
  width: 10px;
  height: 10px;
}

.snj-footer__disclaimer-text {
  font-family: var(--font-body--family);
  font-size: 12px;
  font-weight: 400;
  line-height: 17px;
  color: #ffffff;
  margin: 0;
}

/* ── Legal (policies + copyright) ── */
.snj-footer__legal {
  grid-area: legal;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.snj-footer__policies {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
}

.snj-footer__policy-link {
  font-family: var(--font-body--family);
  font-size: 12px;
  font-weight: 400;
  line-height: 12px;
  color: #E4E4E4;
  text-decoration: none;
}

.snj-footer__policy-link:hover {
  opacity: 0.7;
}

.snj-footer__copyright {
  font-family: var(--font-body--family);
  font-size: 12px;
  font-weight: 400;
  line-height: 12px;
  color: #E4E4E4;
  margin: 0;
}

/* ── Large logo ── */
.snj-footer__large-logo {
  grid-area: logo;
  overflow: hidden;
}

.snj-footer__large-logo-img {
  display: block;
  width: 100%;
  height: auto;
}

.snj-footer__large-logo-img--invert {
  filter: brightness(0) invert(1);
}

/* ── Mobile ── */
@media screen and (max-width: 749px) {
  .snj-footer__container {
    border-radius: 8px;
    padding: 16px 16px 32px 16px;
  }

  .snj-footer__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .snj-footer__nav-columns {
    order: 1;
    gap: 32px;
  }

  .snj-footer__disclaimer {
    order: 2;
    gap: 8px;
  }

  .snj-footer__contact {
    order: 3;
    gap: 12px;
  }

  .snj-footer__legal {
    order: 4;
    padding-top: 16px;
  }

  .snj-footer__large-logo {
    order: 5;
  }

  .snj-footer__policy-link {
    color: #ffffff;
  }

  .snj-footer__copyright {
    color: #ffffff;
    line-height: 17px;
  }
}
{% endstylesheet %}

