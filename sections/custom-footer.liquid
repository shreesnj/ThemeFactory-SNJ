    {
      "type": "text",
      "id": "heading_contact",
      "label": "t:settings.heading_contact",
      "default": "Get in touch"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "t:settings.facebook_url"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "t:settings.pinterest_url"
    },
    {
      "type": "url",
      "id": "instagram_url",
