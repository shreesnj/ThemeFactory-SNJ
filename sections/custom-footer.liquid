{%- liquid
  assign section_id = section.id
  assign color_scheme = section.settings.color_scheme
-%}

<div
  id='section-{{ section_id }}'
  class='custom-footer color-{{ color_scheme }}'
>
  <div class='custom-footer__inner'>
    {%- comment -%} Logo {%- endcomment -%}
    <div class='custom-footer__logo'>
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 320
          | image_tag:
            alt: shop.name,
            loading: 'lazy',
            class: 'custom-footer__logo-img'
        }}
      {%- else -%}
        <img
          src="{{ 'mgemi-wordmark-black-header-e0b82627b944.png' | asset_url }}"
          alt="{{ shop.name }}"
          loading="lazy"
          class="custom-footer__logo-img"
        >
      {%- endif -%}
    </div>

    {%- comment -%} Three-column layout {%- endcomment -%}
    <div class='custom-footer__columns'>
      {%- comment -%} Column 1: Let's Talk {%- endcomment -%}
      <div class='custom-footer__column custom-footer__column--contact'>
        <h3 class='custom-footer__heading'>{{ section.settings.contact_heading | escape }}</h3>

        {%- if section.settings.contact_description != blank -%}
          <div class='custom-footer__description'>{{ section.settings.contact_description }}</div>
        {%- endif -%}

        <ul class='custom-footer__contact-list'>
          {%- if section.settings.phone_number != blank -%}
            <li class='custom-footer__contact-item'>
              <a href='tel:{{ section.settings.phone_number | escape }}' class='custom-footer__contact-link'>
                <span class='custom-footer__contact-icon'>
                  <img
                    src="{{ 'phone-20aa630a5940.svg' | asset_url }}"
                    alt=""
                    width="11"
                    height="18"
                    loading="lazy"
                  >
                </span>
                {{- section.settings.phone_number | escape -}}
              </a>
            </li>
          {%- endif -%}

          {%- if section.settings.email_address != blank -%}
            <li class='custom-footer__contact-item'>
              <a href='mailto:{{ section.settings.email_address | escape }}' class='custom-footer__contact-link'>
                <span class='custom-footer__contact-icon'>
                  <img
                    src="{{ 'envelope-34d83a4b81f3.svg' | asset_url }}"
                    alt=""
                    width="17"
                    height="11"
                    loading="lazy"
                  >
                </span>
                {{- section.settings.email_address | escape -}}
              </a>
            </li>
          {%- endif -%}

          {%- if section.settings.chat_text != blank -%}
            <li class='custom-footer__contact-item'>
              {%- if section.settings.chat_url != blank -%}
                <a href='{{ section.settings.chat_url }}' class='custom-footer__contact-link'>
              {%- else -%}
                <span class='custom-footer__contact-link custom-footer__chat-trigger' role='button' tabindex='0'>
              {%- endif -%}
                <span class='custom-footer__contact-icon'>
                  <img
                    src="{{ 'bubble-f7eecf25d27e.svg' | asset_url }}"
                    alt=""
                    width="15"
                    height="16"
                    loading="lazy"
                  >
                </span>
                {{- section.settings.chat_text | escape -}}
              {%- if section.settings.chat_url != blank -%}
                </a>
              {%- else -%}
                </span>
              {%- endif -%}
            </li>
          {%- endif -%}

          {%- if section.settings.returns_text != blank -%}
            <li class='custom-footer__contact-item'>
              {%- if section.settings.returns_url != blank -%}
                <a href='{{ section.settings.returns_url }}' class='custom-footer__contact-link'>
              {%- else -%}
                <span class='custom-footer__contact-link'>
              {%- endif -%}
                <span class='custom-footer__contact-icon'>
                  <img
                    src="{{ 'package-fd4dd3414a11.svg' | asset_url }}"
                    alt=""
                    width="17"
                    height="17"
                    loading="lazy"
                  >
                </span>
                {{- section.settings.returns_text | escape -}}
              {%- if section.settings.returns_url != blank -%}
                </a>
              {%- else -%}
                </span>
              {%- endif -%}
            </li>
          {%- endif -%}
        </ul>
      </div>

      {%- comment -%} Column 2: Share (desktop: visible, mobile: accordion) {%- endcomment -%}
      <div class='custom-footer__column custom-footer__column--share custom-footer__column--desktop-only'>
        <h3 class='custom-footer__heading'>{{ section.settings.share_heading | escape }}</h3>
        {%- if section.settings.share_menu != blank -%}
          <ul class='custom-footer__link-list'>
            {%- for link in linklists[section.settings.share_menu].links -%}
              <li class='custom-footer__link-item'>
                <a href='{{ link.url }}' class='custom-footer__link'>{{ link.title | escape }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- comment -%} Desktop social icons (inside Share column) {%- endcomment -%}
        <div class='custom-footer__social-icons custom-footer__social-icons--desktop'>
          {%- render 'custom-footer-social-icons', section: section -%}
        </div>
      </div>

      {%- comment -%} Column 2 mobile: Share accordion {%- endcomment -%}
      <details class='custom-footer__accordion custom-footer__accordion--mobile-only'>
        <summary class='custom-footer__accordion-header'>
          <h3 class='custom-footer__heading'>{{ section.settings.share_heading | escape }}</h3>
          <img
            src="{{ 'chevron-down-6f013691a480.svg' | asset_url }}"
            alt=""
            width="8"
            height="8"
            class="custom-footer__chevron"
            loading="lazy"
          >
        </summary>
        <div class='custom-footer__accordion-content'>
          {%- if section.settings.share_menu != blank -%}
            <ul class='custom-footer__link-list'>
              {%- for link in linklists[section.settings.share_menu].links -%}
                <li class='custom-footer__link-item'>
                  <a href='{{ link.url }}' class='custom-footer__link'>{{ link.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </details>

      {%- comment -%} Column 3: Company (desktop: visible, mobile: accordion) {%- endcomment -%}
      <div class='custom-footer__column custom-footer__column--company custom-footer__column--desktop-only'>
        <h3 class='custom-footer__heading'>{{ section.settings.company_heading | escape }}</h3>
        {%- if section.settings.company_menu != blank -%}
          <ul class='custom-footer__link-list'>
            {%- for link in linklists[section.settings.company_menu].links -%}
              <li class='custom-footer__link-item'>
                <a href='{{ link.url }}' class='custom-footer__link'>{{ link.title | escape }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} Column 3 mobile: Company accordion {%- endcomment -%}
      <details class='custom-footer__accordion custom-footer__accordion--mobile-only'>
        <summary class='custom-footer__accordion-header'>
          <h3 class='custom-footer__heading'>{{ section.settings.company_heading | escape }}</h3>
          <img
            src="{{ 'chevron-down-6f013691a480.svg' | asset_url }}"
            alt=""
            width="8"
            height="8"
            class="custom-footer__chevron"
            loading="lazy"
          >
        </summary>
        <div class='custom-footer__accordion-content'>
          {%- if section.settings.company_menu != blank -%}
            <ul class='custom-footer__link-list'>
              {%- for link in linklists[section.settings.company_menu].links -%}
                <li class='custom-footer__link-item'>
                  <a href='{{ link.url }}' class='custom-footer__link'>{{ link.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </details>
    </div>

    {%- comment -%} Mobile social icons row {%- endcomment -%}
    <div class='custom-footer__social-icons custom-footer__social-icons--mobile'>
      {%- render 'custom-footer-social-icons', section: section -%}
    </div>

    {%- comment -%} Optional newsletter {%- endcomment -%}
    {%- if section.settings.show_newsletter -%}
      <div class='custom-footer__newsletter'>
        {%- if section.settings.newsletter_heading != blank -%}
          <h3 class='custom-footer__heading'>{{ section.settings.newsletter_heading | escape }}</h3>
        {%- endif -%}
        {%- form 'customer', class: 'custom-footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class='custom-footer__newsletter-input-group'>
            <input
              type="email"
              name="contact[email]"
              id="FooterNewsletterEmail-{{ section_id }}"
              class="custom-footer__newsletter-input"
              aria-label="Email address"
              autocomplete="email"
              placeholder="Enter your email"
              required
            >
            <button type="submit" class="custom-footer__newsletter-button" aria-label="Subscribe">
              <svg viewBox='0 0 20 20' xmlns='http://www.w3.org/2000/svg' width='20' height='20' aria-hidden='true' focusable='false'>
                {%- render 'icon', icon: 'arrow' -%}
              </svg>
            </button>
          </div>
        {%- endform -%}
      </div>
    {%- endif -%}

    {%- comment -%} Bottom bar {%- endcomment -%}
    <div class='custom-footer__bottom'>
      <div class='custom-footer__copyright'>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
      </div>
      {%- if section.settings.bottom_links_menu != blank -%}
        <ul class='custom-footer__bottom-links'>
          {%- for link in linklists[section.settings.bottom_links_menu].links -%}
            <li class='custom-footer__bottom-link-item'>
              <a href='{{ link.url }}' class='custom-footer__bottom-link'>{{ link.title | escape }}</a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
/* Custom Footer */
.custom-footer {
  color: #000000;
  background-color: var(--color-background);
}

.custom-footer__inner {
  margin-block-start: 40px;
  margin-inline: 64px;
  padding-block-end: 64px;
}

/* Logo */
.custom-footer__logo {
  margin-block-end: 32px;
}

.custom-footer__logo-img {
  display: block;
  max-width: 157px;
  height: auto;
}

/* Columns layout */
.custom-footer__columns {
  display: flex;
}

.custom-footer__column {
  flex: 1;
  flex-basis: 100px;
  padding-block: 8px;
}

.custom-footer__column--contact,
.custom-footer__column--share {
  border-inline-end: 1px solid #B1B1B1;
}

/* Headings */
.custom-footer__heading {
  margin: 0 0 24px;
  font-family: var(--font-body--family);
  font-size: 16px;
  font-weight: 500;
  line-height: 12px;
  letter-spacing: 2.5px;
  text-align: center;
  text-transform: uppercase;
  color: #000000;
}

/* Contact column */
.custom-footer__description {
  margin-block-start: 16px;
  font-family: var(--font-body--family);
  font-size: 14px;
  font-weight: 300;
  line-height: 22px;
  letter-spacing: 0.25px;
  text-align: center;
  color: #000000;
}

.custom-footer__contact-list {
  list-style: none;
  margin: 24px auto 0;
  padding: 0;
  width: fit-content;
}

.custom-footer__contact-item {
  margin-block-end: 16px;
  font-family: var(--font-body--family);
  font-size: 14px;
  font-weight: 300;
  line-height: 20px;
  letter-spacing: 0.25px;
  text-align: start;
  color: #000000;
}

.custom-footer__contact-item:last-child {
  margin-block-end: 0;
}

.custom-footer__contact-link {
  color: inherit;
  text-decoration: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
}

.custom-footer__contact-link:focus-visible {
  outline: 1px auto rgb(0, 95, 204);
  outline-offset: 1px;
}

.custom-footer__contact-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  margin-inline-end: 13px;
  flex-shrink: 0;
}

.custom-footer__contact-icon img {
  max-width: 100%;
  height: auto;
}

/* Link lists */
.custom-footer__link-list {
  list-style: none;
  margin: 0 0 14px;
  padding: 0;
}

.custom-footer__link-item {
  margin-block-end: 16px;
  font-family: var(--font-body--family);
  font-size: 14px;
  font-weight: 300;
  line-height: 22px;
  letter-spacing: 0.25px;
  text-align: center;
  color: #000000;
}

.custom-footer__link-item:last-child {
  margin-block-end: 0;
}

.custom-footer__link {
  color: inherit;
  text-decoration: none;
}

.custom-footer__link:focus-visible {
  outline: 1px auto rgb(0, 95, 204);
  outline-offset: 1px;
}

/* Social icons */
.custom-footer__social-icons {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 10px;
  max-width: 260px;
}

.custom-footer__social-icons--desktop {
  margin: 32px auto 0;
}

.custom-footer__social-icons--mobile {
  display: none;
}

.custom-footer__social-link {
  display: flex;
  align-items: center;
  color: #000000;
  text-decoration: none;
}

.custom-footer__social-link:focus-visible {
  outline: 1px auto rgb(0, 95, 204);
  outline-offset: 1px;
}

.custom-footer__social-link svg {
  width: 20px;
  height: 20px;
}

.custom-footer__social-link img {
  width: 20px;
  height: 20px;
}

/* Accordion (mobile only) */
.custom-footer__accordion {
  display: none;
}

.custom-footer__accordion-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 8px;
  cursor: pointer;
  list-style: none;
}

.custom-footer__accordion-header::-webkit-details-marker {
  display: none;
}

.custom-footer__accordion-header .custom-footer__heading {
  margin: 0;
}

.custom-footer__chevron {
  width: 8px;
  height: 8px;
  transition: transform 0.2s ease-in-out;
}

.custom-footer__accordion[open] .custom-footer__chevron {
  transform: rotate(180deg);
}

.custom-footer__accordion-content {
  padding: 0 8px 20px;
}

/* Newsletter */
.custom-footer__newsletter {
  margin-block-start: 32px;
  text-align: center;
}

.custom-footer__newsletter-form {
  max-width: 400px;
  margin: 0 auto;
}

.custom-footer__newsletter-input-group {
  display: flex;
  gap: 8px;
}

.custom-footer__newsletter-input {
  flex: 1;
  padding: 10px 16px;
  font-family: var(--font-body--family);
  font-size: 14px;
  font-weight: 300;
  border: 1px solid #B1B1B1;
  background: transparent;
  color: #000000;
}

.custom-footer__newsletter-input:focus-visible {
  outline: 1px auto rgb(0, 95, 204);
  outline-offset: 1px;
}

.custom-footer__newsletter-button {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10px;
  background: #000000;
  color: #ffffff;
  border: none;
  cursor: pointer;
}

.custom-footer__newsletter-button:focus-visible {
  outline: 1px auto rgb(0, 95, 204);
  outline-offset: 1px;
}

.custom-footer__newsletter-button svg {
  fill: currentColor;
}

/* Bottom bar */
.custom-footer__bottom {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  margin-block-start: 64px;
}

.custom-footer__copyright {
  font-family: var(--font-body--family);
  font-size: 10px;
  font-weight: 300;
  line-height: 16.667px;
  letter-spacing: 0.1px;
  color: #000000;
}

.custom-footer__bottom-links {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  list-style: none;
  margin: 0;
  padding: 0;
}

.custom-footer__bottom-link-item {
  font-family: var(--font-body--family);
  font-size: 10px;
  font-weight: 300;
  line-height: 16.667px;
  letter-spacing: 0.1px;
  color: #000000;
}

.custom-footer__bottom-link {
  color: inherit;
  text-decoration: none;
}

.custom-footer__bottom-link:focus-visible {
  outline: 1px auto rgb(0, 95, 204);
  outline-offset: 1px;
}

/* Mobile styles */
@media screen and (max-width: 749px) {
  .custom-footer__inner {
    margin-block-start: 40px;
    margin-inline: 19.5px;
    padding-block-end: 19.5px;
  }

  .custom-footer__logo-img {
    max-width: 105px;
  }

  .custom-footer__columns {
    display: block;
  }

  .custom-footer__column--desktop-only {
    display: none;
  }

  .custom-footer__accordion {
    display: block;
    border-block-end: 1px solid #B1B1B1;
  }

  .custom-footer__column--contact {
    border-inline-end: none;
    border-block-end: 1px solid #B1B1B1;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .custom-footer__column--contact .custom-footer__contact-list {
    margin-block-end: 33px;
  }

  .custom-footer__heading {
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 1.5px;
  }

  .custom-footer__description {
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.1px;
  }

  .custom-footer__contact-item {
    font-size: 12px;
    letter-spacing: 0.1px;
  }

  .custom-footer__link-item {
    font-size: 12px;
    letter-spacing: 0.1px;
  }

  .custom-footer__accordion-content .custom-footer__link-item {
    text-align: start;
  }

  .custom-footer__social-icons--desktop {
    display: none;
  }

  .custom-footer__social-icons--mobile {
    display: flex;
    max-width: 100%;
    border-block-end: 1px solid #B1B1B1;
  }

  .custom-footer__bottom {
    margin-block-start: 19.5px;
    justify-content: flex-start;
  }
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .custom-footer__chevron {
    transition: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.custom_footer",
  "tag": "footer",
  "class": "custom-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Let's Talk"
    },
    {
      "type": "textarea",
      "id": "contact_description",
      "label": "Contact description",
      "default": "Questions? We're here for you\nMonday to Friday, 9am-6pm ET."
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number",
      "default": "+1-844-574-4364"
    },
    {
      "type": "text",
      "id": "email_address",
      "label": "Email address",
      "default": "assistant@mgemi.com"
    },
    {
      "type": "text",
      "id": "chat_text",
      "label": "Chat text",
      "default": "Start a chat"
    },
    {
      "type": "url",
      "id": "chat_url",
      "label": "Chat URL"
    },
    {
      "type": "text",
      "id": "returns_text",
      "label": "Returns text",
      "default": "Returns & Exchanges"
    },
    {
      "type": "url",
      "id": "returns_url",
      "label": "Returns URL"
    },
    {
      "type": "header",
      "content": "Share"
    },
    {
      "type": "text",
      "id": "share_heading",
      "label": "Share heading",
      "default": "Share"
    },
    {
      "type": "link_list",
      "id": "share_menu",
      "label": "Share menu"
    },
    {
      "type": "header",
      "content": "Company"
    },
    {
      "type": "text",
      "id": "company_heading",
      "label": "Company heading",
      "default": "Company"
    },
    {
      "type": "link_list",
      "id": "company_menu",
      "label": "Company menu"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter",
      "default": false
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading"
    },
    {
      "type": "header",
      "content": "Social media"
    },
    {
      "type": "url",
      "id": "social_email_url",
      "label": "Email URL"
    },
    {
      "type": "url",
      "id": "social_instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_twitter_url",
      "label": "Twitter URL"
    },
    {
      "type": "url",
      "id": "social_pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "social_tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "link_list",
      "id": "bottom_links_menu",
      "label": "Bottom links menu"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-7"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_footer"
    }
  ]
}
{% endschema %}
