{{ 'custom-sections.css' | asset_url | stylesheet_tag }}

<brand-carousel class="brand-carousel color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="brand-carousel__header">
    <h2 class="brand-carousel__title">{{ section.settings.heading }}</h2>
    <div class="brand-carousel__header-right">
      <div class="brand-carousel__nav">
        <button class="brand-carousel__nav-btn brand-carousel__nav-btn--prev" type="button" aria-label="Previous brands">
          <img src="{{ 'chevron.svg' | asset_url }}" alt="" width="9" height="16" loading="lazy">
        </button>
        <button class="brand-carousel__nav-btn brand-carousel__nav-btn--next" type="button" aria-label="Next brands">
          <img src="{{ 'chevron.svg' | asset_url }}" alt="" width="9" height="16" loading="lazy">
        </button>
      </div>
      {% if section.settings.view_all_link != blank %}
        <a href="{{ section.settings.view_all_link }}" class="brand-carousel__view-all">{{ section.settings.view_all_label }}</a>
      {% else %}
        <a href="#" class="brand-carousel__view-all">{{ section.settings.view_all_label }}</a>
      {% endif %}
    </div>
  </div>

  <div class="brand-carousel__track">
    {% for block in section.blocks %}
      {% if block.type == 'brand-card' %}
        <div class="brand-card" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="brand-card__link" style="text-decoration: none; color: inherit;">
          {% endif %}
          <div class="brand-card__image-wrapper">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 221 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {% else %}
              <span>{{ block.settings.title }}</span>
            {% endif %}
          </div>
          <div class="brand-card__content">
            <h3 class="brand-card__title">{{ block.settings.title }}</h3>
            <p class="brand-card__description">{{ block.settings.description }}</p>
          </div>
          {% if block.settings.link != blank %}
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</brand-carousel>

{% javascript %}
import { Component } from '@theme/component';

class BrandCarousel extends Component {
  connectedCallback() {
    super.connectedCallback();
    this.track = this.querySelector('.brand-carousel__track');
    this.prevBtn = this.querySelector('.brand-carousel__nav-btn--prev');
    this.nextBtn = this.querySelector('.brand-carousel__nav-btn--next');

    if (this.prevBtn && this.track) {
      this.prevBtn.addEventListener('click', () => this.scroll('prev'));
    }
    if (this.nextBtn && this.track) {
      this.nextBtn.addEventListener('click', () => this.scroll('next'));
    }
  }

  scroll(direction) {
    if (!this.track) return;
    const scrollAmount = 237;
    const currentScroll = this.track.scrollLeft;

    if (direction === 'next') {
      this.track.scrollTo({ left: currentScroll + scrollAmount, behavior: 'smooth' });
    } else {
      this.track.scrollTo({ left: currentScroll - scrollAmount, behavior: 'smooth' });
    }
  }
}

customElements.define('brand-carousel', BrandCarousel);
{% endjavascript %}

{% schema %}
{
  "name": "t:names.brand_carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:content.heading",
      "default": "Shop by Brand"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:content.view_all_label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "t:content.view_all_link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:content.padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:content.padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 64,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "brand-card",
      "name": "t:names.brand_card",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:content.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:content.brand_title",
          "default": "Brand Name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:content.brand_description",
          "default": "Brand description text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:content.brand_link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.brand_carousel",
      "blocks": [
        {
          "type": "brand-card",
          "settings": {
            "title": "Isotonix",
            "description": "Vitamins with\nmaximum absorption"
          }
        },
        {
          "type": "brand-card",
          "settings": {
            "title": "Prime",
            "description": "Anti-Aging\nNutraceuticals"
          }
        },
        {
          "type": "brand-card",
          "settings": {
            "title": "Lumiere de Vie",
            "description": "Skin care products\nfor men and women."
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
