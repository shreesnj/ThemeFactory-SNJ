<div
  class="one-routine section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-top: {{ section.settings.padding_block_start }}px;
    --section-padding-bottom: {{ section.settings.padding_block_end }}px;
  "
>
  {% if section.settings.background_image != blank %}
    {{
      section.settings.background_image
      | image_url: width: section.settings.background_image.width
      | image_tag:
        sizes: '100vw',
        widths: '375,550,750,1100,1440,1780,2000',
        loading: 'lazy',
        class: 'one-routine__bg',
        alt: section.settings.background_image.alt
    }}
  {% endif %}

  <div class="one-routine__content">
    <div class="one-routine__header">
      {% if section.settings.heading != blank %}
        <h2 class="one-routine__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.stat_text != blank %}
        <div class="one-routine__stat">
          <span class="one-routine__dot" aria-hidden="true"></span>
          <span class="one-routine__stat-text">{{ section.settings.stat_text | escape }}</span>
        </div>
      {% endif %}
    </div>

    <div class="one-routine__cards">
      {% for block in section.blocks %}
        <div class="one-routine__card" {{ block.shopify_attributes }}>
          <div class="one-routine__card-top">
            {% if block.settings.duration != blank %}
              <span class="one-routine__card-duration">{{ block.settings.duration | escape }}</span>
            {% endif %}
            {% if block.settings.description != blank %}
              <div class="one-routine__card-desc">{{ block.settings.description | escape }}</div>
            {% endif %}
          </div>
          <div class="one-routine__card-bottom">
            {% if block.settings.benefit_1 != blank %}
              <span class="one-routine__card-benefit">{{ block.settings.benefit_1 | escape }}</span>
            {% endif %}
            {% if block.settings.benefit_2 != blank %}
              <span class="one-routine__card-benefit">{{ block.settings.benefit_2 | escape }}</span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
.one-routine {
  position: relative;
  overflow: hidden;
  padding-block-start: calc(var(--section-padding-top, 80) * var(--spacing-scale, 1) * 1px);
  padding-block-end: calc(var(--section-padding-bottom, 80) * var(--spacing-scale, 1) * 1px);
  padding-inline: calc(120px * var(--spacing-scale, 1));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 864px;
}

.one-routine__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
}

.one-routine__content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 20px;
  max-width: 1200px;
  width: 100%;
  align-items: center;
}

.one-routine__header {
  display: flex;
  flex-direction: column;
  gap: 20px;
  justify-content: center;
  padding-inline: 8px;
}

.one-routine__heading {
  font-family: var(--font-custom-serif), serif;
  font-weight: 400;
  font-size: 48px;
  line-height: 60px;
  letter-spacing: -1px;
  color: #FFFFFF;
  margin: 0;
}

.one-routine__stat {
  display: flex;
  flex-direction: row;
  gap: 8px;
  align-items: center;
}

.one-routine__dot {
  display: inline-block;
  width: 12px;
  height: 12px;
  min-width: 12px;
  background-color: #BC0F0F;
  border-radius: 50%;
}

.one-routine__stat-text {
  font-family: var(--font-custom-heading), sans-serif;
  font-weight: 500;
  font-size: 20px;
  line-height: 24px;
  color: #FFFFFF;
}

.one-routine__cards {
  display: flex;
  flex-direction: row;
  gap: 24px;
  align-items: center;
  padding-block: 16px;
  width: 100%;
}

.one-routine__card {
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 48px;
  padding: 20px 24px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(36px);
  -webkit-backdrop-filter: blur(36px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  min-height: 488px;
}

.one-routine__card-top {
  display: flex;
  flex-direction: column;
  gap: 48px;
}

.one-routine__card-duration {
  font-family: var(--font-custom-cta), sans-serif;
  font-weight: 400;
  font-size: 18px;
  line-height: 20px;
  letter-spacing: 0.75px;
  text-transform: uppercase;
  color: #FFFFFF;
}

.one-routine__card-desc {
  font-family: var(--font-custom-serif), serif;
  font-weight: 400;
  font-size: 24px;
  line-height: 28px;
  letter-spacing: -1px;
  color: #FFFFFF;
}

.one-routine__card-bottom {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.one-routine__card-benefit {
  font-family: var(--font-custom-heading), sans-serif;
  font-weight: 500;
  font-size: 18px;
  line-height: 24px;
  letter-spacing: -0.5px;
  color: #FFFFFF;
}

@media screen and (max-width: 749px) {
  .one-routine {
    padding-block-start: calc(var(--section-padding-top, 40) * var(--spacing-scale, 1) * 1px);
    padding-block-end: calc(var(--section-padding-bottom, 40) * var(--spacing-scale, 1) * 1px);
    padding-inline: 12px;
    min-height: 616px;
  }

  .one-routine__header {
    gap: 16px;
  }

  .one-routine__heading {
    font-size: 48px;
    line-height: 48px;
  }

  .one-routine__stat-text {
    font-size: 18px;
    line-height: 20px;
  }

  .one-routine__cards {
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin-inline: -12px;
    padding-inline: 12px;
  }

  .one-routine__cards::-webkit-scrollbar {
    display: none;
  }

  .one-routine__card {
    flex: 0 0 auto;
    width: 280px;
    min-width: 280px;
    min-height: 360px;
    scroll-snap-align: start;
  }

  .one-routine__card-duration {
    font-size: 16px;
    line-height: 18px;
  }

  .one-routine__card-desc {
    font-size: 20px;
    line-height: 24px;
  }

  .one-routine__card-benefit {
    font-size: 16px;
    line-height: 20px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.one_routine",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "One routine. Big impact."
    },
    {
      "type": "text",
      "id": "stat_text",
      "label": "t:settings.stat_text",
      "default": "35K daily active users"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.background_image"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page_width" },
        { "value": "full-width", "label": "t:options.full_width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "impact-card",
      "name": "t:names.impact_card",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "duration",
          "label": "t:settings.duration",
          "default": "30 days"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:settings.description",
          "default": "Card description goes here."
        },
        {
          "type": "text",
          "id": "benefit_1",
          "label": "t:settings.benefit_1",
          "default": "Benefit one"
        },
        {
          "type": "text",
          "id": "benefit_2",
          "label": "t:settings.benefit_2",
          "default": "Benefit two"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.one_routine",
      "blocks": [
        {
          "type": "impact-card",
          "settings": {
            "duration": "30 days",
            "description": "You start building consistency as your routine becomes a part of your daily cardiovascular support.",
            "benefit_1": "Supports nitric oxide levels",
            "benefit_2": "Promotes healthy blood flow"
          }
        },
        {
          "type": "impact-card",
          "settings": {
            "duration": "60 days",
            "description": "You feel the routine take hold as you continue supporting nitric oxide, blood flow, and overall cardiovascular health.",
            "benefit_1": "Enhanced daily energy",
            "benefit_2": "Supports cardiovascular vitality"
          }
        },
        {
          "type": "impact-card",
          "settings": {
            "duration": "90 days",
            "description": "Support becomes part of your daily rhythm, with habits and benefits working together over time",
            "benefit_1": "Optimized blood pressure",
            "benefit_2": "Long-term cardiovascular support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
