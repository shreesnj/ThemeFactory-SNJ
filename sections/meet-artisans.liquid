{% liquid
  assign scale_min = 20
  assign padding_top = section.settings.padding-block-start
  assign padding_bottom = section.settings.padding-block-end
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="
    {%- if padding_top > scale_min -%}
      --padding-block-start: max({{ scale_min }}px, calc(var(--spacing-scale) * {{ padding_top }}px));
    {%- else -%}
      --padding-block-start: {{ padding_top }}px;
    {%- endif -%}
    {%- if padding_bottom > scale_min -%}
      --padding-block-end: max({{ scale_min }}px, calc(var(--spacing-scale) * {{ padding_bottom }}px));
    {%- else -%}
      --padding-block-end: {{ padding_bottom }}px;
    {%- endif -%}
    --columns-desktop: {{ section.settings.columns_desktop }};
    --column-gap: {{ section.settings.column_gap }}px;
  "
>
  <div class="meet-artisans spacing-style">
    {%- if section.settings.heading != blank -%}
      <h2 class="meet-artisans__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="meet-artisans__grid">
      {% for block in section.blocks %}
        <div class="meet-artisans__card" {{ block.shopify_attributes }}>
          <div class="meet-artisans__media">
            {%- if block.settings.image != blank -%}
              {%- assign sizes_val = '(min-width: 750px) 25vw, 68vw' -%}
              {{
                block.settings.image
                | image_url: width: block.settings.image.width
                | image_tag:
                  class: 'meet-artisans__image',
                  sizes: sizes_val,
                  widths: '266,304,532,608,720,1000',
                  loading: 'lazy',
                  alt: block.settings.image.alt
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'meet-artisans__placeholder' }}
            {%- endif -%}
          </div>

          <div class="meet-artisans__cta">
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">
                {{- block.settings.link_text -}}
              </a>
            {%- else -%}
              <span>{{ block.settings.link_text }}</span>
            {%- endif -%}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .meet-artisans {
    padding-block-start: var(--padding-block-start, 0px);
    padding-block-end: var(--padding-block-end, 0px);
  }

  .meet-artisans__heading {
    font-family: var(--font-heading--family);
    font-size: 30px;
    line-height: 1.1;
    text-align: center;
    margin: 0 0 14px;
    color: var(--color-foreground);
  }

  @media screen and (min-width: 750px) {
    .meet-artisans__heading {
      font-size: 48px;
      margin: 0 0 48px;
    }
  }

  .meet-artisans__grid {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 24px;
    margin-inline: calc(-1 * var(--page-margin, 16px));
    padding-inline: var(--page-margin, 16px);
    scrollbar-width: thin;
    scrollbar-color: rgb(0, 0, 0) rgb(118, 118, 118);
  }

  .meet-artisans__grid::-webkit-scrollbar {
    height: 2px;
  }

  .meet-artisans__grid::-webkit-scrollbar-track {
    background: rgb(118, 118, 118);
    border-radius: 10px;
  }

  .meet-artisans__grid::-webkit-scrollbar-thumb {
    background: rgb(0, 0, 0);
    border-radius: 10px;
  }

  @media screen and (min-width: 750px) {
    .meet-artisans__grid {
      display: grid;
      grid-template-columns: repeat(var(--columns-desktop, 4), 1fr);
      column-gap: var(--column-gap, 32px);
      overflow: visible;
      scroll-snap-type: none;
      padding-bottom: 0;
      margin-inline: 0;
      padding-inline: 0;
    }
  }

  .meet-artisans__card {
    flex: 0 0 68%;
    scroll-snap-align: start;
  }

  @media screen and (min-width: 750px) {
    .meet-artisans__card {
      flex: none;
    }
  }

  .meet-artisans__media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .meet-artisans__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meet-artisans__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meet-artisans__cta {
    margin-top: 33px;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .meet-artisans__cta {
      margin-top: 55px;
    }
  }

  .meet-artisans__cta a,
  .meet-artisans__cta span {
    font-family: var(--font-subheading--family);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  @media screen and (min-width: 750px) {
    .meet-artisans__cta a,
    .meet-artisans__cta span {
      letter-spacing: 0.8px;
    }
  }

  .meet-artisans__cta a:focus-visible {
    outline: 1px auto currentColor;
    outline-offset: 1px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.meet_artisans",
  "tag": "section",
  "class": "meet-artisans-wrapper section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "The Essentials"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        { "value": "page-width", "label": "t:options.page_width" },
        { "value": "full-width", "label": "t:options.full_width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.grid_layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:settings.columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "number",
      "id": "column_gap",
      "label": "t:settings.column_gap",
      "default": 32
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 88,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:names.card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "t:settings.link_text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.meet_artisans",
      "category": "t:categories.storytelling",
      "settings": {
        "color_scheme": "scheme-1",
        "section_width": "page-width",
        "columns_desktop": 4,
        "column_gap": 32,
        "padding-block-start": 0,
        "padding-block-end": 88
      },
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
