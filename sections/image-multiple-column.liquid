{% liquid
  assign scale_min = 20
  assign padding_top = section.settings.padding-block-start
  assign padding_bottom = section.settings.padding-block-end
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="
    {%- if padding_top > scale_min -%}
      --padding-block-start: max({{ scale_min }}px, calc(var(--spacing-scale) * {{ padding_top }}px));
    {%- else -%}
      --padding-block-start: {{ padding_top }}px;
    {%- endif -%}
    {%- if padding_bottom > scale_min -%}
      --padding-block-end: max({{ scale_min }}px, calc(var(--spacing-scale) * {{ padding_bottom }}px));
    {%- else -%}
      --padding-block-end: {{ padding_bottom }}px;
    {%- endif -%}
    --columns-desktop: {{ section.settings.columns_desktop }};
    --column-gap: {{ section.settings.column_gap }}px;
    --row-gap: {{ section.settings.row_gap }}px;
  "
>
  <div class="image-multiple-column__grid spacing-style">
    {% for block in section.blocks %}
      <div class="image-multiple-column__card" {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" class="image-multiple-column__link">
        {% endif %}

        <div class="image-multiple-column__media">
          {% if block.settings.image != blank %}
            {%- assign sizes_val = '(min-width: 750px) calc((100vw - 2 * var(--page-margin, 40px) - 32px) / 2), calc(100vw - 2 * var(--page-margin, 16px))' -%}
            {{
              block.settings.image
              | image_url: width: block.settings.image.width
              | image_tag:
                class: 'image-multiple-column__image',
                sizes: sizes_val,
                widths: '351,640,720,1000,1280',
                loading: 'lazy',
                alt: block.settings.image.alt
            }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'image-multiple-column__placeholder' }}
          {% endif %}
        </div>

        <div class="image-multiple-column__content">
          {% if block.settings.eyebrow != blank %}
            <p class="image-multiple-column__eyebrow">{{ block.settings.eyebrow }}</p>
          {% endif %}
          {% if block.settings.heading != blank %}
            <p class="image-multiple-column__heading">{{ block.settings.heading }}</p>
          {% endif %}
        </div>

        {% if block.settings.link != blank %}
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .image-multiple-column__grid {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 32px;
    padding-block-start: var(--padding-block-start, 0px);
    padding-block-end: var(--padding-block-end, 0px);
  }

  @media screen and (min-width: 750px) {
    .image-multiple-column__grid {
      grid-template-columns: repeat(var(--columns-desktop, 2), 1fr);
      column-gap: var(--column-gap, 32px);
      row-gap: var(--row-gap, 64px);
    }
  }

  .image-multiple-column__card {
    display: flex;
    flex-direction: column;
  }

  .image-multiple-column__link {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .image-multiple-column__link:focus-visible {
    outline: 1px auto currentColor;
    outline-offset: 2px;
  }

  .image-multiple-column__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .image-multiple-column__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-multiple-column__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-multiple-column__content {
    margin-block-start: 21px;
  }

  @media screen and (min-width: 750px) {
    .image-multiple-column__content {
      margin-block-start: 39px;
    }
  }

  .image-multiple-column__eyebrow {
    font-family: var(--font-subheading--family);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 1.25px;
    text-transform: uppercase;
    margin: 0 0 11px;
  }

  @media screen and (min-width: 750px) {
    .image-multiple-column__eyebrow {
      font-size: 16px;
      line-height: 24px;
      letter-spacing: 2px;
      margin: 0 0 5px;
    }
  }

  .image-multiple-column__heading {
    font-family: var(--font-heading--family);
    font-size: 24px;
    line-height: 32px;
    letter-spacing: -0.25px;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .image-multiple-column__heading {
      font-size: 32px;
      line-height: 42px;
      letter-spacing: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.image_multiple_column",
  "class": "image-multiple-column-wrapper section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        { "value": "page-width", "label": "t:options.page_width" },
        { "value": "full-width", "label": "t:options.full_width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.grid_layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:settings.columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "number",
      "id": "column_gap",
      "label": "t:settings.column_gap",
      "default": 32
    },
    {
      "type": "number",
      "id": "row_gap",
      "label": "t:settings.row_gap",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 88,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:names.card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:settings.eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.image_multiple_column",
      "category": "t:categories.storytelling",
      "settings": {
        "color_scheme": "scheme-1",
        "section_width": "page-width",
        "columns_desktop": 2,
        "column_gap": 32,
        "row_gap": 64,
        "padding-block-start": 0,
        "padding-block-end": 88
      },
      "blocks": [
        {
          "type": "card",
          "settings": {
            "eyebrow": "TRAVEL-READY STYLES",
            "heading": "For wearing here, there, and everywhere"
          }
        },
        {
          "type": "card",
          "settings": {
            "eyebrow": "NEW ARRIVALS",
            "heading": "Handwoven sandals, just in from Italy"
          }
        }
      ]
    }
  ]
}
{% endschema %}
